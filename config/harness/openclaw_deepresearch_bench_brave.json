{
  "_doc": "OpenClaw DeepResearch-Bench harness using Brave Search. Model/deployment selected separately.",
  "harness": "openclaw",
  "openclaw": {
    "gateway": {
      "mode": "local",
      "bind": "loopback",
      "auth": {
        "mode": "token",
        "token": {
          "source": "env",
          "provider": "env",
          "id": "OPENCLAW_GATEWAY_TOKEN"
        }
      }
    },
    "diagnostics": {
      "enabled": true,
      "otel": {
        "enabled": true,
        "endpoint": "http://localhost:4318",
        "protocol": "http/protobuf",
        "serviceName": "agent-bench-openclaw",
        "traces": true,
        "metrics": true,
        "logs": true,
        "sampleRate": 1,
        "flushIntervalMs": 20
      },
      "cacheTrace": {
        "enabled": true,
        "includeMessages": true,
        "includePrompt": true,
        "includeSystem": true
      }
    },
    "tools": {
      "profile": "coding",
      "web": {
        "search": {
          "provider": "brave",
          "enabled": true
        },
        "fetch": {
          "enabled": true
        }
      },
      "sandbox": {
        "tools": {
          "allow": [
            "exec", "process", "read", "write", "edit", "apply_patch", "image",
            "sessions_list", "sessions_history", "sessions_send",
            "sessions_spawn", "sessions_yield", "subagents", "session_status",
            "web_search", "web_fetch",
            "memory_get", "memory_search"
          ]
        }
      }
    },
    "skills": {
      "load": {
        "extraDirs": ["/root/.openclaw/skills"]
      }
    },
    "plugins": {
      "entries": {
        "vllm": {"enabled": true},
        "memory-core": {"enabled": true},
        "diagnostics-otel": {"enabled": true}
      }
    },
    "agents": {
      "defaults": {
        "workspace": "/workspace",
        "subagents": {
          "maxConcurrent": 4,
          "runTimeoutSeconds": 1200
        }
      },
      "list": [
        {
          "id": "deep_researcher",
          "default": true,
          "name": "deep-researcher",
          "skills": ["research_fetch"]
        }
      ]
    }
  },
  "evaluation": {
    "judge_provider": "deepseek",
    "judge_model": "deepseek-v4-pro",
    "pass_threshold": 0.5
  },
  "conditions": [
    {
      "condition_id": "openclaw_agent",
      "condition_type": "openclaw_agent",
      "description": "OpenClaw agent driving a DeepResearch-Bench task container (Brave Search)",
      "agent": {
        "max_steps": 300,
        "max_time_seconds": 3000,
        "retry_limit": 5
      }
    }
  ]
}
