{
  "_doc": "OpenClaw harness for Terminal-Bench (Qwen/Qwen3.6-27B). Same shape as openclaw_27b.json but agents.defaults.workspace=/app (TB convention) and the registered agent id is `terminal_bench` (TerminalBenchOpenClawCondition uses `--agent terminal_bench`; the TB harness predicts the sandbox container name from the same id). Per-app prompts (AGENTS.md etc) come from applications/terminal_bench/openclaw/agents/.",
  "harness": "openclaw",
  "model": {
    "name": "Qwen/Qwen3.6-27B",
    "endpoint": "http://localhost:8000/v1",
    "temperature": 0.0,
    "max_tokens": 4096
  },
  "openclaw": {
    "gateway": {
      "mode": "local",
      "bind": "loopback",
      "auth": {
        "mode": "token",
        "token": {
          "source": "env",
          "provider": "env",
          "id": "OPENCLAW_GATEWAY_TOKEN"
        }
      }
    },
    "diagnostics": {
      "enabled": true,
      "otel": {
        "enabled": true,
        "endpoint": "http://localhost:4318",
        "protocol": "http/protobuf",
        "serviceName": "agent-bench-openclaw",
        "traces": true,
        "metrics": true,
        "logs": true,
        "sampleRate": 1,
        "flushIntervalMs": 20
      },
      "cacheTrace": {
        "enabled": true,
        "includeMessages": true,
        "includePrompt": true,
        "includeSystem": true
      }
    },
    "tools": {
      "exec": {
        "host": "gateway",
        "security": "full"
      },
      "alsoAllow": ["sessions_spawn", "sessions_yield", "subagents"]
    },
    "skills": {
      "load": {
        "extraDirs": ["/root/.openclaw/skills"]
      }
    },
    "plugins": {
      "entries": {
        "vllm":             {"enabled": true},
        "memory-core":      {"enabled": true},
        "diagnostics-otel": {"enabled": true},
        "anthropic":        {"enabled": false},
        "openai":           {"enabled": false},
        "openrouter":       {"enabled": false},
        "litellm":          {"enabled": false},
        "lmstudio":         {"enabled": false},
        "xai":              {"enabled": false},
        "groq":             {"enabled": false},
        "together":         {"enabled": false},
        "fireworks":        {"enabled": false},
        "deepseek":         {"enabled": false},
        "moonshot":         {"enabled": false},
        "mistral":          {"enabled": false},
        "cohere":           {"enabled": false},
        "google":           {"enabled": false},
        "vertex":           {"enabled": false},
        "bedrock":          {"enabled": false},
        "azure":            {"enabled": false},
        "ollama":           {"enabled": false},
        "huggingface":      {"enabled": false},
        "minimax":          {"enabled": false},
        "perplexity":       {"enabled": false},
        "qwen":             {"enabled": false}
      }
    },
    "models": {
      "providers": {
        "vllm": {
          "baseUrl": "http://localhost:8000/v1",
          "apiKey": "sk-dummy"
        }
      }
    },
    "agents": {
      "defaults": {
        "workspace": "/app",
        "subagents": {
          "maxConcurrent": 4,
          "runTimeoutSeconds": 600
        }
      },
      "list": [
        {
          "id": "terminal_bench",
          "default": true,
          "name": "terminal-bench-operator",
          "skills": ["verify"]
        }
      ]
    }
  },
  "conditions": [
    {
      "condition_id": "openclaw_agent",
      "condition_type": "openclaw_agent",
      "description": "OpenClaw agent driving a Terminal-Bench task container",
      "agent": {
        "max_steps": 200,
        "max_time_seconds": 1500,
        "retry_limit": 5
      }
    }
  ]
}
