{
  "_doc": "OpenClaw harness against locally-mounted Qwen/Qwen3.5-9B. model.name is the absolute path to the on-disk HF snapshot (must match SGLANG_MODEL_DIR so OC requests the same served-model-name sglang registers). Sibling of openclaw_qwen3_14b_sglang.json; differs only in model.name. Use with config/backend/sglang/tp1.json.",
  "harness": "openclaw",
  "model": {
    "name": "/scratch/users/ntu/n2505289/model/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a",
    "endpoint": "http://localhost:8000/v1",
    "temperature": 0.0,
    "max_tokens": 4096
  },
  "openclaw": {
    "gateway": {
      "mode": "local",
      "bind": "loopback",
      "auth": {
        "mode": "token",
        "token": {
          "source": "env",
          "provider": "env",
          "id": "OPENCLAW_GATEWAY_TOKEN"
        }
      }
    },
    "diagnostics": {
      "enabled": true,
      "otel": {
        "enabled": true,
        "endpoint": "http://localhost:4318",
        "protocol": "http/protobuf",
        "serviceName": "agent-bench-openclaw",
        "traces": true,
        "metrics": true,
        "logs": true,
        "sampleRate": 1,
        "flushIntervalMs": 20
      },
      "cacheTrace": {
        "enabled": true,
        "includeMessages": true,
        "includePrompt": true,
        "includeSystem": true
      }
    },
    "tools": {
      "exec": {
        "host": "gateway",
        "security": "full"
      },
      "alsoAllow": ["sessions_spawn", "sessions_yield", "subagents"]
    },
    "skills": {
      "load": {
        "extraDirs": ["/root/.openclaw/skills"]
      }
    },
    "plugins": {
      "entries": {
        "vllm":                  {"enabled": true},
        "memory-core":           {"enabled": true},
        "diagnostics-otel":      {"enabled": true},
        "browser":               {"enabled": false},
        "amazon-bedrock":        {"enabled": false},
        "amazon-bedrock-mantle": {"enabled": false},
        "anthropic":             {"enabled": false},
        "anthropic-vertex":      {"enabled": false},
        "openai":                {"enabled": false},
        "google":                {"enabled": false},
        "xai":                   {"enabled": false},
        "ollama":                {"enabled": false},
        "lmstudio":              {"enabled": false},
        "mistral":               {"enabled": false},
        "fireworks":             {"enabled": false},
        "github-copilot":        {"enabled": false},
        "kimi":                  {"enabled": false},
        "microsoft":             {"enabled": false},
        "deepgram":              {"enabled": false},
        "elevenlabs":            {"enabled": false},
        "openrouter":            {"enabled": false},
        "litellm":               {"enabled": false},
        "groq":                  {"enabled": false},
        "together":              {"enabled": false},
        "deepseek":              {"enabled": false},
        "moonshot":              {"enabled": false},
        "huggingface":           {"enabled": false},
        "minimax":               {"enabled": false},
        "qwen":                  {"enabled": false}
      }
    },
    "models": {
      "providers": {
        "vllm": {
          "baseUrl": "http://localhost:8000/v1",
          "apiKey": "sk-dummy",
          "api": "openai-completions"
        }
      }
    },
    "agents": {
      "defaults": {
        "workspace": "/testbed",
        "subagents": {
          "maxConcurrent": 4,
          "runTimeoutSeconds": 600
        }
      },
      "list": [
        {
          "id": "swebench",
          "default": true,
          "name": "swebench-coder",
          "skills": ["verify"]
        }
      ]
    }
  },
  "conditions": [
    {
      "condition_id": "openclaw_agent",
      "condition_type": "openclaw_agent",
      "description": "OpenClaw code agent: full trajectory",
      "agent": {
        "max_steps": 500,
        "max_time_seconds": 1800,
        "retry_limit": 10
      }
    }
  ]
}
