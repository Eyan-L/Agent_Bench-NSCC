# Copy to .env and fill. Source via `set -a; . .env; set +a`.

# --- Backend selection ---
SERVING_BACKEND=sglang        # vllm | sglang

# --- sglang backend (see backend/sglang/defaults.env for full set) ---
SGLANG_MODEL_PATH=/models/Qwen3-30B-A3B-Instruct
SGLANG_PORT=30000
SGLANG_MEM_FRACTION=0.85
SGLANG_PATCH_MODE=bind        # bind | copy | baked | skip

# --- vLLM backend (see backend/vllm/defaults.env for full set) ---
VLLM_PORT=8000
VLLM_GPU_MEM_FRACTION=0.85

# --- OpenClaw frontend (see eval/frontend/openclaw/defaults.env) ---
OC_HOST_NODE=/usr/local/bin/node
OC_HOST_OPENCLAW=/usr/local/lib/node_modules/openclaw
OC_PATCH_MODE=runtime         # runtime | baked | skip
OC_AGENT_NAME=swebench

# --- Eval driver ---
EVAL_MAX_WORKERS=1
