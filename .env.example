# Copy to .env and fill. Source via:
#   set -a; . .env; set +a

# --- Composed config defaults ---------------------------------------
# These mirror the Makefile's four-axis config model.
APP=swebench/phase0
HARNESS=openclaw_swebench
MODEL_PROFILE=qwen35_9b
SERVING=vllm/default

# Local runs normally use Docker. NSCC/PBS jobs set this to singularity in
# scripts/execution_pbs/run_benchmark.pbs.
HARNESS_BACKEND=docker

# Optional run identity. Leave empty to let Make/PBS generate
# data/experiments/<timestamp>/...
AB_RUN_STAMP=

# --- SWE-bench local inputs -----------------------------------------
# PBS Stage 0 materializes these on NSCC; local make eval needs explicit paths.
SWEBENCH_ROOT=
INSTANCE_DATA=
EVAL_MAX_WORKERS=1

# --- Local serving launchers ----------------------------------------
# Derived from SERVING by Makefile by default. Valid local `make serve`
# launchers are vllm and sglang. Provider models should use a LiteLLM serving
# config under config/serving/litellm/ and are primarily started by PBS.
SERVING_BACKEND=vllm
PORT=8000

# vLLM knobs used by backend/vllm/serve.sh and PBS.
VLLM_TP=1
GPU_MEM_UTIL=0.85

# SGLang knobs used by backend/sglang/serve.sh.
SGLANG_MODEL_PATH=Qwen/Qwen3-30B-A3B-Instruct-2507
SGLANG_TP=1
SGLANG_CONTEXT_LENGTH=
SGLANG_MEM_FRACTION_STATIC=0.85
SGLANG_TOOL_CALL_PARSER=qwen3_coder
SGLANG_REASONING_PARSER=qwen3

# --- Provider-backed serving through LiteLLM ------------------------
# Agents connect only to the local LiteLLM proxy; provider API keys stay in
# the proxy process/container.
LITELLM_MASTER_KEY=sk-agent-bench-local

# --- OpenClaw runtime patch helpers ---------------------------------
# Only needed when applying OpenClaw patches to a local checkout/package.
OC_HOST_OPENCLAW=/usr/local/lib/node_modules/openclaw
OC_PATCH_MODE=runtime
