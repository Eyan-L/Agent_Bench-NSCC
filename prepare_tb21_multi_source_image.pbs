#!/usr/bin/env bash
#PBS -N tb21-image-multi-source
#PBS -P personal-n2602695
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=04:00:00
#PBS -q normal
#PBS -j oe

set -euo pipefail

module load python/3.10.9
module load apptainer/1.5.0

export SCRATCH=/scratch/users/ntu/$USER

export SINGULARITY_CACHEDIR=$SCRATCH/.sing_cache
export SINGULARITY_TMPDIR=$SCRATCH/.sing_tmp

mkdir -p "$SINGULARITY_CACHEDIR"
mkdir -p "$SINGULARITY_TMPDIR"
mkdir -p "$SCRATCH/task-images"

cd "${PBS_O_WORKDIR:-$PWD}"

export AB_BENCHMARK_TASKS_ROOT="$SCRATCH/datasets/terminal-bench-2-1-7131e4375048/tasks"
export AB_DEPLOYMENT_TASK_IMAGE_DIR="$SCRATCH/task-images"

echo "=== environment ==="
which singularity
singularity --version

echo "=== pulling Terminal-Bench task image ==="

python3 -m agent_bench.deployments.pbs.terminal_bench_images \
  --sif-dir "$SCRATCH/task-images" \
  --task-id multi-source-data-merger

echo "=== result ==="
ls -lh "$SCRATCH/task-images"

echo "DONE"
