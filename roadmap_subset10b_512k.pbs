#!/usr/bin/env bash
# Generated by Agent Bench PBS renderer for NSCC.
#PBS -N agent-bench-nscc_qwen36_35b_a3b_roadmapbench_subagent_subset10b_512k
#PBS -l select=1:ngpus=4
#PBS -l walltime=24:00:00
#PBS -q normal
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
export AB_PBS_SITE=NSCC
if [[ -z "${AB_RUN_STAMP:-}" ]]; then
    AB_RUN_STAMP="$(TZ=Asia/Singapore date +%Y-%m-%d_%H-%M-%S)"
    if [[ -n "${PBS_JOBID:-}" ]]; then
        AB_JOB_SUFFIX="${PBS_JOBID//[^A-Za-z0-9._-]/_}"
        AB_RUN_STAMP="${AB_RUN_STAMP}_${AB_JOB_SUFFIX}"
    fi
fi
export AB_RUN_STAMP
export AB_EXPERIMENT_BASE=/home/users/ntu/n2602695/Agent_Bench/runs/nscc_qwen36_35b_a3b_roadmapbench_subagent_subset10b_512k
if [[ -n "${AB_RUN_DIR:-}" && -n "${AB_EXPERIMENT_DIR:-}" && "$AB_RUN_DIR" != "$AB_EXPERIMENT_DIR" ]]; then
    echo "AB_RUN_DIR and AB_EXPERIMENT_DIR are aliases and must match when both are set" >&2
    exit 2
fi
AB_RUN_DIR="${AB_RUN_DIR:-${AB_EXPERIMENT_DIR:-$AB_EXPERIMENT_BASE/$AB_RUN_STAMP}}"
export AB_RUN_DIR
export AB_EXPERIMENT_DIR="$AB_RUN_DIR"
export AB_LOG_DIR="${AB_LOG_DIR:-$AB_RUN_DIR/logs}"
export AB_STAGE_SUMMARY=prepare_environment=1,materialize_benchmark=1,prepare_images=1,start_serving=1,start_otel=1,run_benchmark=1,cleanup=1
export SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1
export SINGULARITYENV_SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1
python3 run.py --config experiments/nscc_qwen36_35b_a3b_roadmapbench_subagent_subset10b_512k.toml
