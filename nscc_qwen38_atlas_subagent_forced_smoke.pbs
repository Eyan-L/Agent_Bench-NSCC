#!/usr/bin/env bash
# Generated by Agent Bench PBS renderer for NSCC.
#PBS -N atlas-forced-subagent-smoke
#PBS -P personal-n2602695
#PBS -l select=1:ngpus=4
#PBS -l walltime=10:00:00
#PBS -q normal
#PBS -j oe

set -euo pipefail

export SERVE_READY_TIMEOUT=1800

module load python/3.10.9
module load apptainer/1.5.0

export SCRATCH=/scratch/users/ntu/$USER
export HF_HOME=$SCRATCH/hf
export HF_ENDPOINT=https://huggingface.co
export PYTHONPATH="$SCRATCH/pylib:${PYTHONPATH:-}"
export SINGULARITY_CACHEDIR=$SCRATCH/.sing_cache
export SINGULARITY_TMPDIR=$SCRATCH/.sing_tmp
export SINGULARITY_BINDPATH="$SCRATCH:$SCRATCH"
export SINGULARITYENV_HF_HOME="$HF_HOME"

cd "${PBS_O_WORKDIR:-$PWD}"
export AB_SERVING_BASE_URL=http://127.0.0.1:30000/v1
export AB_SERVING_API_KEY=EMPTY

export AB_PBS_SITE=NSCC
if [[ -z "${AB_RUN_STAMP:-}" ]]; then
    AB_RUN_STAMP="$(TZ=Asia/Singapore date +%Y-%m-%d_%H-%M-%S)"
    if [[ -n "${PBS_JOBID:-}" ]]; then
        AB_JOB_SUFFIX="${PBS_JOBID//[^A-Za-z0-9._-]/_}"
        AB_RUN_STAMP="${AB_RUN_STAMP}_${AB_JOB_SUFFIX}"
    fi
fi
export AB_RUN_STAMP
export AB_EXPERIMENT_BASE=/home/users/ntu/n2602695/Agent_Bench/runs/nscc_qwen38_swe_atlas_qa_subagent_forced_smoke
if [[ -n "${AB_RUN_DIR:-}" && -n "${AB_EXPERIMENT_DIR:-}" && "$AB_RUN_DIR" != "$AB_EXPERIMENT_DIR" ]]; then
    echo "AB_RUN_DIR and AB_EXPERIMENT_DIR are aliases and must match when both are set" >&2
    exit 2
fi
AB_RUN_DIR="${AB_RUN_DIR:-${AB_EXPERIMENT_DIR:-$AB_EXPERIMENT_BASE/$AB_RUN_STAMP}}"
export AB_RUN_DIR
export AB_EXPERIMENT_DIR="$AB_RUN_DIR"
export AB_LOG_DIR="${AB_LOG_DIR:-$AB_RUN_DIR/logs}"
export AB_STAGE_SUMMARY=prepare_environment=1,materialize_benchmark=1,prepare_images=1,start_serving=1,start_otel=1,run_benchmark=1,cleanup=1
python3 run.py --config experiments/nscc_qwen38_swe_atlas_qa_subagent_forced_smoke.toml --skip-cadvisor-setup
