#!/bin/bash
# The PBS resource request and serving tensor parallelism are launch-time
# choices. The header asks for 4 GPUs; set VLLM_TP=4 at qsub time when you want
# vLLM to use all of them. A cheap smoke should pass the four config axes:
#   qsub -l select=1:ncpus=16:ngpus=1:mem=64gb \
#     -v APP=$KIT_ROOT/profiles/benchmarks/swebench/phase0.json,HARNESS_CONFIG=$KIT_ROOT/profiles/harnesses/openclaw_swebench.json,MODEL_CONFIG=$KIT_ROOT/profiles/models/qwen35_9b.json,SERVING_CONFIG=$KIT_ROOT/profiles/serving/vllm/nscc.json,VLLM_TP=1 \
#     agent_bench/deployments/pbs/run_benchmark.pbs
#PBS -l select=1:ncpus=1:ngpus=4:mem=64gb
#PBS -l walltime=24:00:00
#PBS -q normal
#PBS -j oe
#PBS -N ab_swebench_bench
# The script redirects stdout/stderr into
# data/experiments/$AB_RUN_STAMP/logs/pbs.log after resolving KIT_ROOT.
# Until then, PBS uses its job-id-based default output path.
#
# End-to-end benchmark on the cluster (no docker).
#
# Stages (each can be skipped via env flag):
#   0. STAGE_SWEBENCH=1  — pip install swebench into a persistent scratch
#                          lib cache ($OC_PYLIB), idempotent
#   1. STAGE_PULL=1      — pull SWE-bench instance .sif images via pull_images.sh
#   2. STAGE_SERVING=1   — start local serving sidecar (vLLM, LiteLLM proxy,
#                          and future SGLang support)
#   3. STAGE_OC_CHECK=1  — prepare the selected harness runtime sif
#                          (OpenClaw/OpenHands/Hermes all build locally on NSCC
#                          from a base/upstream sif unless a remote final
#                          runtime image is explicitly provided)
#   3.5 STAGE_OTEL=1     — start local OTel collector that writes
#                          $OC_OTEL_DATA_DIR/otel-traces.jsonl, the file
#                          openclaw_agent.py slices into spans.jsonl
#   4. STAGE_RUN=1       — invoke agent_bench/runtime/driver with the sweep
#   5. STAGE_CLEANUP=1   — kill serving sidecar + OTel collector, free ports
#
# Env (override via `qsub -v K1=V1,K2=V2 ...`):
#   KIT_ROOT       — repo root (default: $PBS_O_WORKDIR or $HOME/Agent_Bench)
#   OC_PYLIB       — pip --target dir for swebench + deps (default: $SCRATCH/pylib)
#   OC_PIP_CACHE   — pip wheel cache (default: $SCRATCH/.pip-cache)
#   DATASET        — instance JSON (default: $KIT_ROOT/profiles/benchmarks/swebench/verified.json)
#   APP            — application JSON (default: $KIT_ROOT/profiles/benchmarks/swebench/phase1.json)
#                    Drives the instance list + scoring image + output_dir.
#   HARNESS_CONFIG — harness JSON  (default: $KIT_ROOT/profiles/harnesses/openclaw_swebench.json)
#                    Selects agent runtime (openclaw / openhands / hermes).
#   MODEL_CONFIG   — model JSON    (default: $KIT_ROOT/profiles/models/qwen36_35b_a3b.json)
#                    Selects model id/path and model-level limits.
#   SERVING_CONFIG — serving JSON  (default: $KIT_ROOT/profiles/serving/vllm/nscc.json)
#                    Selects vLLM/SGLang endpoint, image/SIF, and scheduler knobs.
#   OC_PKG         — (deprecated, unused) host openclaw npm pkg location
#   SIF_DIR        — instance .sif dir (default: /scratch/users/ntu/$USER/swebench)
#   OC_RUNTIME_BASE_SIF — upstream OpenClaw sif pulled from OC_RUNTIME_DOCKER
#   OC_RUNTIME_SIF — patched OpenClaw runtime sif used by the harness
#   OH_RUNTIME_SIF — OpenHands runtime sif used by the harness
#   HM_RUNTIME_SIF — patched Hermes runtime sif used by the harness
#   OC_RUNTIME_REBUILD — rebuild patched OpenClaw runtime even if it exists
#   VLLM_SIF       — vllm sif path (default: /scratch/users/ntu/$USER/sif_images/vllm_openai.sif)
#   VLLM_MODEL     — model id override (normally read from MODEL_CONFIG)
#   VLLM_PORT      — vllm port (default: 8000)
#   VLLM_TP        — tensor parallel (default: 1; set at qsub time)
#   LITELLM_SIF    — LiteLLM proxy sif path for SERVING_BACKEND=litellm
#   LITELLM_DOCKER — LiteLLM proxy image to pull when LITELLM_SIF is missing
#   LITELLM_PORT_AUTO — for LiteLLM, choose a free local port unless PORT or
#                       LITELLM_PORT was explicitly passed (default: 1)
#   AB_RUN_STAMP   — stable experiment directory name
#                    (default: Singapore wall time plus PBS_JOBID when present)
#   AB_EXPERIMENT_DIR — experiment root (default: $KIT_ROOT/data/experiments/$AB_RUN_STAMP)
#   OC_LOG_DIR     — log directory (default: $AB_EXPERIMENT_DIR/logs)
#   STAGE_*        — set to 0 to skip a stage
#
# Submit:
#   qsub agent_bench/deployments/pbs/run_benchmark.pbs
#   qsub -v STAGE_PULL=0,APP=$KIT_ROOT/profiles/benchmarks/swebench/phase0.json \
#        agent_bench/deployments/pbs/run_benchmark.pbs

set -uo pipefail   # not -e; we want stage failures to log + continue cleanup

# ---- Resolve paths ---------------------------------------------------------
USER_NAME="${USER:-$(whoami)}"
HOME="/home/users/ntu/${USER_NAME}"
SCRATCH="${SCRATCH:-/scratch/users/ntu/$USER_NAME}"
if [[ ! -d "$SCRATCH" ]]; then
    echo "FATAL: SCRATCH=$SCRATCH does not exist. Set SCRATCH to a writable large filesystem via qsub -v SCRATCH=/path/to/scratch,..." >&2
    exit 1
fi
PBS_O_WORKDIR=${SCRATCH}/github/Agent_Bench
KIT_ROOT="${KIT_ROOT:-${PBS_O_WORKDIR:-$HOME/Agent_Bench}}"
export SCRATCH HOME KIT_ROOT

# The JSON config loaders use modern Python syntax. Load the cluster Python
# module before calling them; otherwise NSCC login/compute nodes may pick an
# older system python and fail before the job log is even initialized.
if command -v module >/dev/null 2>&1; then
    module load python/3.12.1-gcc11 2>/dev/null || module load python 2>/dev/null || true
fi
command -v python3 >/dev/null 2>&1 || { echo "FATAL: python3 not found" >&2; exit 1; }

# SWEBENCH_ROOT only needs to point at *some* directory — driver uses it
# for an existence check before delegating import work to PYTHONPATH.
# Stage 0 sets it to $OC_PYLIB; we pre-bind it here for the case where
# stage 0 is skipped.
SWEBENCH_ROOT="${SWEBENCH_ROOT:-$SCRATCH/pylib}"
DATASET="${DATASET:-$KIT_ROOT/profiles/benchmarks/swebench/verified.json}"
APP="${APP:-$KIT_ROOT/profiles/benchmarks/swebench/phase1.json}"
HARNESS_CONFIG="${HARNESS_CONFIG:-$KIT_ROOT/profiles/harnesses/openclaw_swebench.json}"

# OC_PKG is a vestige — nothing in this script (or the harness) consumes
# it. Stage 3 bakes patches into a patched OpenClaw runtime sif against
# the sif's own /app package root by default; no host-side pkg dir needed.
# Stage 4 (driver) goes through the Container abstraction
# (agent_bench/deployments/containers/) which doesn't read OC_PKG either.
OC_PKG="${OC_PKG:-}"
SIF_DIR="${SIF_DIR:-$SCRATCH/swebench}"
SINGULARITY_CACHE="${SINGULARITY_CACHE:-$SCRATCH/.singularity}"

OC_RUNTIME_VERSION_DEFAULT="2026.4.22"
OC_PATCH_VERSION_FILE="$KIT_ROOT/agent_bench/harnesses/openclaw/patch/VERSION"
if [[ -f "$OC_PATCH_VERSION_FILE" ]]; then
    OC_RUNTIME_VERSION_DEFAULT="$(awk -F': *' '$1 == "upstream_version" { print $2; exit }' "$OC_PATCH_VERSION_FILE")"
fi
OC_RUNTIME_VERSION="${OC_RUNTIME_VERSION:-${OC_RUNTIME_VERSION_DEFAULT:-2026.4.22}}"
OC_RUNTIME_BASE_SIF="${OC_RUNTIME_BASE_SIF:-$SCRATCH/sif_images/openclaw_${OC_RUNTIME_VERSION}.sif}"
OC_RUNTIME_SIF="${OC_RUNTIME_SIF:-$SCRATCH/sif_images/openclaw_${OC_RUNTIME_VERSION}_patched.sif}"
OC_RUNTIME_DOCKER="${OC_RUNTIME_DOCKER:-docker://ghcr.io/openclaw/openclaw:${OC_RUNTIME_VERSION}}"
OC_RUNTIME_REBUILD="${OC_RUNTIME_REBUILD:-0}"
OC_RUNTIME_OVERLAY="${OC_RUNTIME_OVERLAY:-}"
OC_INSIDE_PKG="${OC_INSIDE_PKG:-/app}"
OH_RUNTIME_SIF="${OH_RUNTIME_SIF:-$SCRATCH/sif_images/openhands_runtime.sif}"
OH_RUNTIME_DOCKER="${OH_RUNTIME_DOCKER:-}"
OH_RUNTIME_VERSION_DEFAULT="1.21.0"
OH_VERSION_FILE="$KIT_ROOT/agent_bench/harnesses/openhands/VERSION"
if [[ -f "$OH_VERSION_FILE" ]]; then
    OH_RUNTIME_VERSION_DEFAULT="$(awk -F': *' '$1 == "upstream_version" { print $2; exit }' "$OH_VERSION_FILE")"
fi
OH_RUNTIME_VERSION="${OH_RUNTIME_VERSION:-${OH_RUNTIME_VERSION_DEFAULT:-1.21.0}}"
OH_RUNTIME_BASE_SIF="${OH_RUNTIME_BASE_SIF:-$SCRATCH/sif_images/openhands_python3.12.sif}"
OH_RUNTIME_BASE_DOCKER="${OH_RUNTIME_BASE_DOCKER:-docker://python:3.12}"
OH_RUNTIME_REBUILD="${OH_RUNTIME_REBUILD:-0}"
HM_RUNTIME_SIF="${HM_RUNTIME_SIF:-$SCRATCH/sif_images/hermes_runtime.sif}"
HM_RUNTIME_DOCKER="${HM_RUNTIME_DOCKER:-}"
HM_RUNTIME_VERSION_DEFAULT="v2026.5.16"
HM_VERSION_FILE="$KIT_ROOT/agent_bench/harnesses/hermes/patch/VERSION"
if [[ -f "$HM_VERSION_FILE" ]]; then
    HM_RUNTIME_VERSION_DEFAULT="$(awk -F': *' '$1 == "upstream_version" { print $2; exit }' "$HM_VERSION_FILE")"
fi
HM_RUNTIME_VERSION="${HM_RUNTIME_VERSION:-${HM_RUNTIME_VERSION_DEFAULT:-v2026.5.16}}"
HM_RUNTIME_BASE_SIF="${HM_RUNTIME_BASE_SIF:-$SCRATCH/sif_images/hermes_${HM_RUNTIME_VERSION}.sif}"
HM_RUNTIME_BASE_DOCKER="${HM_RUNTIME_BASE_DOCKER:-docker://nousresearch/hermes-agent:${HM_RUNTIME_VERSION}}"
HM_RUNTIME_REBUILD="${HM_RUNTIME_REBUILD:-0}"
export OH_RUNTIME_SIF HM_RUNTIME_SIF
export OH_IMAGE="${OH_IMAGE:-$OH_RUNTIME_SIF}"
export HM_IMAGE="${HM_IMAGE:-$HM_RUNTIME_SIF}"

# Four-axis config defaults.
VLLM_DEVICE_DEFAULT=cuda
MODEL_CONFIG_DEFAULT="$KIT_ROOT/profiles/models/qwen36_35b_a3b.json"
SERVING_CONFIG_DEFAULT="$KIT_ROOT/profiles/serving/vllm/nscc.json"

MODEL_CONFIG="${MODEL_CONFIG:-$MODEL_CONFIG_DEFAULT}"
SERVING_CONFIG="${SERVING_CONFIG:-$SERVING_CONFIG_DEFAULT}"
export AB_MODEL_CONFIG="$MODEL_CONFIG"
export AB_SERVING_CONFIG="$SERVING_CONFIG"
AB_PORT_PRESET="${PORT+x}"
AB_LITELLM_PORT_PRESET="${LITELLM_PORT+x}"
eval "$(python3 "$KIT_ROOT/scripts/load_model_env.py" "$MODEL_CONFIG")"
eval "$(python3 "$KIT_ROOT/scripts/load_serving_env.py" "$SERVING_CONFIG")"

if [[ -n "${MODEL_ENDPOINT:-}" ]]; then
    export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$MODEL_ENDPOINT}"
fi
if [[ -n "${MODEL_API_KEY:-}" && "$MODEL_API_KEY" != "EMPTY" ]]; then
    export OPENAI_API_KEY="${OPENAI_API_KEY:-$MODEL_API_KEY}"
    export OC_VLLM_API_KEY="${OC_VLLM_API_KEY:-$MODEL_API_KEY}"
fi
if [[ -n "${MODEL_PROVIDER:-}" && "$MODEL_PROVIDER" != "custom" ]]; then
    export HERMES_INFERENCE_PROVIDER="${HERMES_INFERENCE_PROVIDER:-$MODEL_PROVIDER}"
fi

VLLM_DEVICE="${VLLM_DEVICE:-$VLLM_DEVICE_DEFAULT}"
VLLM_MODEL="${VLLM_MODEL:-$MODEL}"

# vLLM image/SIF come from SERVING_CONFIG when set; explicit VLLM_* env vars
# still win. Device-specific defaults are only fallbacks for serving profiles
# that omit image/SIF.
if [[ "$VLLM_DEVICE" == "cpu" ]]; then
    VLLM_SIF_DEFAULT="${SERVING_SIF:-$SCRATCH/sif_images/vllm_openai_cpu.sif}"
    VLLM_DOCKER_DEFAULT="${SERVING_IMAGE:-docker://vllm/vllm-openai-cpu:latest}"
else
    VLLM_SIF_DEFAULT="${SERVING_SIF:-$SCRATCH/sif_images/vllm_openai_cu128.sif}"
    VLLM_DOCKER_DEFAULT="${SERVING_IMAGE:-docker://vllm/vllm-openai:latest}"
fi
VLLM_SIF="${VLLM_SIF:-$VLLM_SIF_DEFAULT}"
VLLM_DOCKER="${VLLM_DOCKER:-$VLLM_DOCKER_DEFAULT}"
VLLM_TP="${VLLM_TP:-${TP:-1}}"
VLLM_MAX_LEN="${VLLM_MAX_LEN:-${MAX_MODEL_LEN:-${MODEL_CONTEXT_WINDOW:-131072}}}"
VLLM_PORT="${VLLM_PORT:-$PORT}"
# `--gpu-memory-utilization` is overloaded: on the CPU image it caps CPU RAM
# (default 0.92 trips OOM on small nodes since it includes other processes'
# allocations). Use a conservative default for cpu; bench profile keeps 0.90
# on GPU.
if [[ "$VLLM_DEVICE" == "cpu" ]]; then
    VLLM_GPU_UTIL="${VLLM_GPU_UTIL:-0.5}"
else
    # 0.93 just barely covers cudagraph capture overhead on 2x A100-40GB
    # (vllm warns at 0.9 that effective KV mem drops by 0.0228 due to graphs).
    VLLM_GPU_UTIL="${VLLM_GPU_UTIL:-$GPU_MEM_UTIL}"
fi

LITELLM_SIF="${LITELLM_SIF:-${SERVING_SIF:-$SCRATCH/sif_images/litellm_main_stable.sif}}"
LITELLM_DOCKER="${LITELLM_DOCKER:-${SERVING_IMAGE:-docker://docker.litellm.ai/berriai/litellm:main-stable}}"
LITELLM_PORT="${LITELLM_PORT:-$PORT}"
LITELLM_PORT_AUTO="${LITELLM_PORT_AUTO:-1}"
LITELLM_MASTER_KEY="${LITELLM_MASTER_KEY:-${LITELLM_PROXY_API_KEY:-sk-agent-bench-local}}"
LITELLM_NUM_WORKERS="${LITELLM_NUM_WORKERS:-${LITELLM_PROXY_NUM_WORKERS:-4}}"
LITELLM_UPSTREAM_BASE_URL="${LITELLM_UPSTREAM_BASE_URL:-${SERVING_PROVIDER_BASE_URL:-}}"
LITELLM_MODEL_ALIAS="${LITELLM_MODEL_ALIAS:-$MODEL}"
LITELLM_UPSTREAM_MODEL="${LITELLM_UPSTREAM_MODEL:-${LITELLM_MODEL:-openai/$MODEL}}"
if [[ "${SERVING_BACKEND:-vllm}" == "litellm" \
      && "$LITELLM_PORT_AUTO" == "1" \
      && -z "$AB_PORT_PRESET" \
      && -z "$AB_LITELLM_PORT_PRESET" ]]; then
    LITELLM_PORT="$(python3 - <<'PY'
import socket

sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
PY
)"
    PORT="$LITELLM_PORT"
    MODEL_ENDPOINT="http://127.0.0.1:$LITELLM_PORT/v1"
    OPENAI_BASE_URL="$MODEL_ENDPOINT"
    SERVING_PROVIDER_INTERNAL_ENDPOINT="$MODEL_ENDPOINT"
    export PORT MODEL_ENDPOINT OPENAI_BASE_URL SERVING_PROVIDER_INTERNAL_ENDPOINT
fi
if [[ "${SERVING_BACKEND:-vllm}" == "litellm" ]]; then
    PORT="$LITELLM_PORT"
    MODEL_ENDPOINT="http://127.0.0.1:$LITELLM_PORT/v1"
    OPENAI_BASE_URL="$MODEL_ENDPOINT"
    SERVING_PROVIDER_INTERNAL_ENDPOINT="$MODEL_ENDPOINT"
    export PORT MODEL_ENDPOINT OPENAI_BASE_URL SERVING_PROVIDER_INTERNAL_ENDPOINT
fi

OC_PULL_PARALLEL="${OC_PULL_PARALLEL:-2}"

STAGE_SWEBENCH="${STAGE_SWEBENCH:-1}"
STAGE_PULL="${STAGE_PULL:-1}"
STAGE_SERVING="${STAGE_SERVING:-1}"
export STAGE_SERVING
STAGE_OC_CHECK="${STAGE_OC_CHECK:-1}"
STAGE_OTEL="${STAGE_OTEL:-1}"
STAGE_RUN="${STAGE_RUN:-1}"
STAGE_CLEANUP="${STAGE_CLEANUP:-1}"

# Persistent pip cache. Single dir holds every package pulled in by stage 0 so
# subsequent jobs skip download. Located on scratch so it's cluster-shared
# and big.
OC_PYLIB="${OC_PYLIB:-$SCRATCH/pylib}"
OC_PIP_CACHE="${OC_PIP_CACHE:-$SCRATCH/.pip-cache}"

if [[ -z "${AB_RUN_STAMP:-}" ]]; then
    AB_RUN_STAMP="$(TZ=Asia/Singapore date +%Y-%m-%d_%H-%M-%S)"
    if [[ -n "${PBS_JOBID:-}" ]]; then
        AB_JOB_SUFFIX="${PBS_JOBID//[^A-Za-z0-9._-]/_}"
        AB_RUN_STAMP="${AB_RUN_STAMP}_${AB_JOB_SUFFIX}"
    fi
fi
export AB_RUN_STAMP

EXPERIMENT_DIR="${AB_EXPERIMENT_DIR:-$KIT_ROOT/data/experiments/$AB_RUN_STAMP}"
export AB_EXPERIMENT_DIR="$EXPERIMENT_DIR"

LOG_DIR="${OC_LOG_DIR:-$EXPERIMENT_DIR/logs}"
export OC_LOG_DIR="$LOG_DIR"

# OTel collector — local sidecar that catches OC gateway spans and writes
# them to $OC_OTEL_DATA_DIR/otel-traces.jsonl, which openclaw_agent.py
# slices into per-run spans.jsonl files. See pbs/otel_collector.sh for the
# full set of OC_OTEL_* env knobs.
OC_OTEL_DATA_DIR="${OC_OTEL_DATA_DIR:-$LOG_DIR/otel}"
export OC_OTEL_DATA_DIR
# Tell openclaw_agent.py where to read the trace file from. Default in code
# is /tmp/otel/otel-traces.jsonl which doesn't survive HPC tmpfs limits.
export OC_OTEL_TRACE_FILE="${OC_OTEL_TRACE_FILE:-$OC_OTEL_DATA_DIR/otel-traces.jsonl}"

mkdir -p "$EXPERIMENT_DIR/runs" "$LOG_DIR" "$SIF_DIR" "$SINGULARITY_CACHE" "$OC_OTEL_DATA_DIR"
cd "$KIT_ROOT"

LOG_PREFIX() { echo "[$(date -u +%FT%TZ)] $*"; }

# Keep a stable per-run copy of the whole job log. PBS's default job output is
# only a bootstrap fallback after this point.
exec >>"$LOG_DIR/pbs.log" 2>&1

LOG_PREFIX "kit_root      = $KIT_ROOT"
LOG_PREFIX "swebench_root = $SWEBENCH_ROOT"
LOG_PREFIX "run_stamp     = $AB_RUN_STAMP"
LOG_PREFIX "experiment    = $AB_EXPERIMENT_DIR"
LOG_PREFIX "log_dir       = $LOG_DIR"
LOG_PREFIX "app           = $APP"
LOG_PREFIX "harness       = $HARNESS_CONFIG"
LOG_PREFIX "model         = $MODEL_CONFIG"
LOG_PREFIX "serving       = $SERVING_CONFIG"
LOG_PREFIX "serving backend = ${SERVING_BACKEND:-unknown}  provider=${SERVING_PROVIDER_NAME:-none}"
LOG_PREFIX "model endpoint  = ${MODEL_ENDPOINT:-unset}"
LOG_PREFIX "dataset       = $DATASET"
LOG_PREFIX "oc_pkg        = $OC_PKG"
LOG_PREFIX "sif_dir       = $SIF_DIR"
if [[ "${STAGE_SERVING:-1}" == "1" ]]; then
    case "${SERVING_BACKEND:-vllm}" in
        litellm)
            LOG_PREFIX "litellm_sif   = $LITELLM_SIF"
            LOG_PREFIX "litellm proxy = model=$LITELLM_MODEL_ALIAS upstream=$LITELLM_UPSTREAM_MODEL port=$LITELLM_PORT"
            ;;
        sglang)
            LOG_PREFIX "sglang        = selected (launcher not wired in this PBS script yet)"
            ;;
        vllm)
            LOG_PREFIX "vllm_sif      = $VLLM_SIF"
            LOG_PREFIX "vllm serving  = device=$VLLM_DEVICE  model=$VLLM_MODEL  tp=$VLLM_TP  max_len=$VLLM_MAX_LEN"
            ;;
        *)
            LOG_PREFIX "serving       = unsupported backend=${SERVING_BACKEND:-unknown}"
            ;;
    esac
else
    LOG_PREFIX "serving sidecar = skipped (serving backend=${SERVING_BACKEND:-unknown})"
fi
LOG_PREFIX "stages: pull=$STAGE_PULL serving=$STAGE_SERVING oc=$STAGE_OC_CHECK otel=$STAGE_OTEL run=$STAGE_RUN cleanup=$STAGE_CLEANUP"

# ---- Modules ---------------------------------------------------------------
module load singularity 2>/dev/null || LOG_PREFIX "WARN: 'module load singularity' failed; assuming binary on PATH"
command -v singularity >/dev/null 2>&1 || { LOG_PREFIX "FATAL: singularity not found"; exit 1; }
export SINGULARITY_CACHEDIR="$SINGULARITY_CACHE"

# Node + python from modules where available; else fall back to PATH.
# module load nodejs 2>/dev/null || true
if command -v module >/dev/null 2>&1; then
    module load python/3.12.1-gcc11 2>/dev/null || module load python 2>/dev/null || true
fi
command -v python3 >/dev/null 2>&1 || { LOG_PREFIX "FATAL: python3 not found"; exit 1; }
# command -v node    >/dev/null 2>&1 || { LOG_PREFIX "FATAL: node not found"; exit 1; }

HARNESS_CHOICE="$(
python3 - "$HARNESS_CONFIG" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        print((json.load(fh).get("harness") or "openclaw").lower())
except Exception:
    print("openclaw")
PY
)"
LOG_PREFIX "harness_choice = $HARNESS_CHOICE"

# ============================================================================
# Stage 0: ensure SWE-bench checkout + python install
# ============================================================================
if [[ "$STAGE_SWEBENCH" == "1" ]]; then
    LOG_PREFIX "==== STAGE 0: pip install swebench into shared lib cache ===="
    mkdir -p "$OC_PYLIB" "$OC_PIP_CACHE"
    export PYTHONPATH="$OC_PYLIB:${PYTHONPATH:-}"
    LOG_PREFIX "  PYTHONPATH prefixed with $OC_PYLIB"
    LOG_PREFIX "  pip cache dir   = $OC_PIP_CACHE"

    if ! python3 -c "from swebench.harness.test_spec.test_spec import make_test_spec; from swebench.harness.grading import get_eval_report" 2>/dev/null; then
        LOG_PREFIX "  pip install --target $OC_PYLIB swebench (cached at $OC_PIP_CACHE)"
        python3 -m pip install \
            --target "$OC_PYLIB" \
            --cache-dir "$OC_PIP_CACHE" \
            --upgrade \
            swebench \
            >"$LOG_DIR/pip-swebench.log" 2>&1 \
            || { LOG_PREFIX "FATAL: pip install swebench failed; tail:"; tail -40 "$LOG_DIR/pip-swebench.log"; exit 1; }
        python3 -c "from swebench.harness.test_spec.test_spec import make_test_spec; from swebench.harness.grading import get_eval_report" \
            || { LOG_PREFIX "FATAL: swebench still not importable"; exit 1; }
        LOG_PREFIX "  swebench install OK"
    else
        LOG_PREFIX "  swebench already importable from $OC_PYLIB; skipping install"
    fi
    # Driver still passes a SWEBENCH_ROOT around for legacy reasons; point it
    # at the installed package dir so any directory-existence check succeeds.
    SWEBENCH_ROOT="$OC_PYLIB"

    # Materialize $DATASET as a slim JSON containing only the instances the
    # application config actually uses. Source of truth = the app JSON's
    # `instances:` list. Pulls full instance dicts (problem_statement /
    # test_patch / FAIL_TO_PASS / ...) from princeton-nlp/SWE-bench_Verified.
    LOG_PREFIX "  building $DATASET from $APP ids (HF SWE-bench_Verified)"
    mkdir -p "$(dirname "$DATASET")"
    OC_APP="$APP" OC_DATASET_OUT="$DATASET" \
    python3 - <<'PY' || { LOG_PREFIX "FATAL: dataset materialize failed"; exit 1; }
import json, os, sys
from datasets import load_dataset

app_path = os.environ["OC_APP"]
out_path = os.environ["OC_DATASET_OUT"]

with open(app_path) as fh:
    app = json.load(fh)
ids = list(app.get("instances") or [])
if not ids:
    print(f"app {app_path} has no instances", file=sys.stderr); sys.exit(1)

want = set(ids)
existing = []
if os.path.exists(out_path):
    try:
        existing = json.load(open(out_path))
        have = {d.get("instance_id") for d in existing}
        if want.issubset(have):
            print(f"  dataset already covers all {len(ids)} ids; skip"); sys.exit(0)
    except Exception:
        pass

hf_name  = os.environ.get("OC_HF_DATASET", "princeton-nlp/SWE-bench_Verified")
hf_split = os.environ.get("OC_HF_SPLIT", "test")
ds = load_dataset(hf_name, split=hf_split)
filt = [dict(r) for r in ds if r["instance_id"] in want]
missing = want - {d["instance_id"] for d in filt}
if missing:
    print(f"WARN: {len(missing)} ids not in HF dataset: {sorted(missing)[:5]}...", file=sys.stderr)

# Merge with any pre-existing file so multi-sweep prefetches accumulate.
keep_by_id = {d["instance_id"]: d for d in existing}
keep_by_id.update({d["instance_id"]: d for d in filt})
with open(out_path, "w") as fh:
    json.dump(list(keep_by_id.values()), fh)
print(f"  wrote {len(filt)} (total {len(keep_by_id)}) instances -> {out_path}")
PY
fi

# ============================================================================
# Stage 1: pull instance .sif images
# ============================================================================
if [[ "$STAGE_PULL" == "1" ]]; then
    LOG_PREFIX "==== STAGE 1: pull instance .sif images ===="
    if [[ ! -f "$DATASET" ]]; then
        LOG_PREFIX "ERROR: dataset not found at $DATASET — skipping pull"
    else
        # Only pull instances that this app config actually uses, not all 500.
        app_instances() {
            python3 - <<PY
import json, sys
with open("$APP") as fh:
    y = json.load(fh)
for i in y.get("instances") or []:
    print(i)
PY
        }
        TMP_LIST="$SIF_DIR/.app_instances.txt"
        app_instances > "$TMP_LIST"
        LOG_PREFIX "  pulling $(wc -l < "$TMP_LIST") instances from $APP"
        OC_SIF_DIR="$SIF_DIR" bash "$KIT_ROOT/agent_bench/deployments/pbs/pull_images.sh" \
            --instances "$TMP_LIST" \
            --dir "$SIF_DIR" \
            --parallel "$OC_PULL_PARALLEL" \
            || LOG_PREFIX "WARN: some pulls failed (see $SIF_DIR/*.pull.log)"
    fi
fi

# ============================================================================
# Stage 2: serving sidecar (vLLM or LiteLLM proxy)
# ============================================================================
VLLM_LOG="$LOG_DIR/vllm.log"
VLLM_PID=""
LITELLM_LOG="$LOG_DIR/litellm.log"
LITELLM_PID=""
if [[ "$STAGE_SERVING" == "1" ]]; then
    case "${SERVING_BACKEND:-vllm}" in
        vllm|litellm)
            ;;
        sglang)
            LOG_PREFIX "FATAL: SERVING_BACKEND=sglang is recognized, but this PBS launcher does not start SGLang yet."
            LOG_PREFIX "  Wire a Stage 2 SGLang branch before using profiles/serving/sglang/*.json here."
            exit 2
            ;;
        *)
            LOG_PREFIX "FATAL: unsupported SERVING_BACKEND=${SERVING_BACKEND:-unset}"
            exit 2
            ;;
    esac
fi

if [[ "$STAGE_SERVING" == "1" && "${SERVING_BACKEND:-vllm}" == "litellm" ]]; then
    LOG_PREFIX "==== STAGE 2: start LiteLLM proxy singularity (provider=${SERVING_PROVIDER_NAME:-unknown}) ===="
    LOG_PREFIX "  litellm sif    = $LITELLM_SIF"
    LOG_PREFIX "  litellm docker = $LITELLM_DOCKER"
    if [[ ! -f "$LITELLM_SIF" ]]; then
        LOG_PREFIX "  litellm sif not found; pulling $LITELLM_DOCKER"
        mkdir -p "$(dirname "$LITELLM_SIF")"
        if ! singularity pull "$LITELLM_SIF" "$LITELLM_DOCKER" >>"$LOG_DIR/litellm-pull.log" 2>&1; then
            LOG_PREFIX "FATAL: singularity pull failed; tail of $LOG_DIR/litellm-pull.log:"
            tail -30 "$LOG_DIR/litellm-pull.log"
            exit 2
        fi
        LOG_PREFIX "  pulled litellm sif -> $LITELLM_SIF"
    fi

    UPSTREAM_KEY_ENV="${SERVING_PROVIDER_API_KEY_ENV:-}"
    UPSTREAM_KEY=""
    if [[ -n "$UPSTREAM_KEY_ENV" ]]; then
        UPSTREAM_KEY="${!UPSTREAM_KEY_ENV:-}"
    fi
    if [[ -z "$UPSTREAM_KEY" ]]; then
        LOG_PREFIX "FATAL: LiteLLM upstream API key missing."
        LOG_PREFIX "  Set ${UPSTREAM_KEY_ENV:-SERVING_PROVIDER_API_KEY_ENV} in the qsub environment."
        exit 2
    fi
    LITELLM_CONFIG="$LOG_DIR/litellm_config.yaml"
    python3 -m agent_bench.serving.render_litellm_config --output "$LITELLM_CONFIG"
    : > "$LITELLM_LOG"

    LITELLM_TMPDIR="${LITELLM_TMPDIR:-$SCRATCH/.tmp/${PBS_JOBID:-manual}-litellm}"
    mkdir -p "$LITELLM_TMPDIR"
    export SINGULARITYENV_TMPDIR="$LITELLM_TMPDIR"
    export SINGULARITYENV_LITELLM_UPSTREAM_BASE_URL="$LITELLM_UPSTREAM_BASE_URL"
    export SINGULARITYENV_LITELLM_UPSTREAM_API_KEY="$UPSTREAM_KEY"
    export SINGULARITYENV_LITELLM_MASTER_KEY="$LITELLM_MASTER_KEY"
    export SINGULARITYENV_NO_TELEMETRY="1"

    singularity exec --containall \
        --bind "$LITELLM_CONFIG:$LITELLM_CONFIG:ro" \
        --bind "$LITELLM_TMPDIR:$LITELLM_TMPDIR:rw" \
        --bind "$LOG_DIR:/logs:rw" \
        "$LITELLM_SIF" \
        litellm --config "$LITELLM_CONFIG" \
            --host "${BIND_HOST:-0.0.0.0}" \
            --port "$LITELLM_PORT" \
            --num_workers "$LITELLM_NUM_WORKERS" \
        > "$LITELLM_LOG" 2>&1 &
    LITELLM_PID=$!
    LOG_PREFIX "  litellm pid=$LITELLM_PID, log=$LITELLM_LOG"

    unset SINGULARITYENV_TMPDIR \
          SINGULARITYENV_LITELLM_UPSTREAM_BASE_URL \
          SINGULARITYENV_LITELLM_UPSTREAM_API_KEY \
          SINGULARITYENV_LITELLM_MASTER_KEY \
          SINGULARITYENV_NO_TELEMETRY

    export MODEL_ENDPOINT="http://127.0.0.1:$LITELLM_PORT/v1"
    export OPENAI_BASE_URL="$MODEL_ENDPOINT"
    export MODEL_API_KEY="$LITELLM_MASTER_KEY"
    export OPENAI_API_KEY="$LITELLM_MASTER_KEY"
    export OC_VLLM_API_KEY="$LITELLM_MASTER_KEY"
    export HERMES_INFERENCE_PROVIDER="${LITELLM_AGENT_PROVIDER:-custom}"

    DEADLINE=$(( $(date +%s) + 600 ))
    until curl -fsS \
            -H "Authorization: Bearer $LITELLM_MASTER_KEY" \
            "http://127.0.0.1:$LITELLM_PORT/v1/models" >/dev/null 2>&1; do
        if ! kill -0 "$LITELLM_PID" 2>/dev/null; then
            LOG_PREFIX "FATAL: litellm exited; tail of log:"
            tail -80 "$LITELLM_LOG"
            exit 3
        fi
        if [ "$(date +%s)" -ge "$DEADLINE" ]; then
            LOG_PREFIX "FATAL: litellm not ready after 600s"
            tail -80 "$LITELLM_LOG"
            kill "$LITELLM_PID" 2>/dev/null || true
            exit 3
        fi
        sleep 5
    done
    LOG_PREFIX "  litellm ready on http://127.0.0.1:$LITELLM_PORT/v1"
fi

if [[ "$STAGE_SERVING" == "1" && "${SERVING_BACKEND:-vllm}" == "vllm" ]]; then
    LOG_PREFIX "==== STAGE 2: start vLLM singularity (device=$VLLM_DEVICE) ===="
    LOG_PREFIX "  vllm sif    = $VLLM_SIF"
    LOG_PREFIX "  vllm docker = $VLLM_DOCKER"
    if [[ ! -f "$VLLM_SIF" ]]; then
        LOG_PREFIX "  vllm sif not found; pulling $VLLM_DOCKER"
        mkdir -p "$(dirname "$VLLM_SIF")"
        if ! singularity pull "$VLLM_SIF" "$VLLM_DOCKER" >>"$LOG_DIR/vllm-pull.log" 2>&1; then
            LOG_PREFIX "FATAL: singularity pull failed; tail of $LOG_DIR/vllm-pull.log:"
            tail -30 "$LOG_DIR/vllm-pull.log"
            exit 2
        fi
        LOG_PREFIX "  pulled vllm sif → $VLLM_SIF"
    fi
    : > "$VLLM_LOG"
    # Redirect every "throwaway" cache + tmp dir from /tmp (small tmpfs on HPC
    # compute nodes) to scratch. Pre-create every subdir vllm/torch/HF will
    # touch — `--containall` later strips host binds, so any path that isn't
    # explicitly bound (or pre-created under a bound parent) blows up at
    # runtime ("Read-only file system" / FileNotFoundError).
    OC_TMPDIR="${OC_TMPDIR:-$SCRATCH/.tmp/$PBS_JOBID}"
    mkdir -p \
        "$OC_TMPDIR" \
        "$SCRATCH/.cache/huggingface" \
        "$SCRATCH/.cache/torchinductor" \
        "$SCRATCH/.cache/triton" \
        "$SCRATCH/.cache/vllm" \
        "$SCRATCH/.cache/vllm/modelinfos"
    # Don't `export TMPDIR` on the host — singularity (without --containall)
    # leaks the host TMPDIR into the OC gateway container in stage 4, where
    # $SCRATCH/.tmp/$PBS_JOBID isn't bound and node's os.tmpdir() crashes
    # with ENOENT. SINGULARITYENV_TMPDIR is enough to point vllm at scratch
    # while leaving the host-side TMPDIR at its default (/tmp) for stage 4.
    export SINGULARITYENV_TMPDIR="$OC_TMPDIR"
    export SINGULARITYENV_TORCHINDUCTOR_CACHE_DIR="$SCRATCH/.cache/torchinductor"
    export SINGULARITYENV_HF_HOME="$SCRATCH/.cache/huggingface"
    export SINGULARITYENV_HUGGINGFACE_HUB_CACHE="$SCRATCH/.cache/huggingface"
    export SINGULARITYENV_XDG_CACHE_HOME="$SCRATCH/.cache"
    export SINGULARITYENV_VLLM_CACHE_ROOT="$SCRATCH/.cache/vllm"
    # Triton's cache manager ignores XDG_CACHE_HOME — it uses $TRITON_CACHE_DIR,
    # falling back to $HOME/.triton/cache. With --containall, $HOME points at
    # the container's tiny overlay (no scratch bind), so kernel compiles bomb
    # with `OSError: [Errno 28] No space left on device` partway through MoE
    # autotune. Force the cache + base dir onto bound scratch.
    export SINGULARITYENV_TRITON_CACHE_DIR="$SCRATCH/.cache/triton"
    export SINGULARITYENV_TRITON_HOME="$SCRATCH/.cache/triton"
    LOG_PREFIX "  TMPDIR              = $OC_TMPDIR"
    LOG_PREFIX "  XDG_CACHE_HOME      = $SCRATCH/.cache"

    # CPU profile sanity check: vllm reserves 1 core internally; ncpus=1
    # leaves 0 for workers and trips libgomp `OMP_NUM_THREADS="0"`. Need ≥2.
    if [[ "$VLLM_DEVICE" == "cpu" ]]; then
        AVAILABLE_CPUS="$(nproc 2>/dev/null || echo 1)"
        if (( AVAILABLE_CPUS < 2 )); then
            LOG_PREFIX "FATAL: CPU profile needs at least 2 CPUs (saw $AVAILABLE_CPUS)."
            LOG_PREFIX "  Resubmit with: -l select=1:ncpus=8:mem=32gb (or more)"
            exit 2
        fi
        LOG_PREFIX "  cpu count    = $AVAILABLE_CPUS"
    fi

    # CUDA driver visibility: singularity's --nv only works if libcuda.so.1
    # and friends are visible on the host. On HPC nodes that means loading
    # the cluster's cuda module before launching the container. Default to
    # cuda/12.2.2 (matches vllm-openai image's CUDA 12.x build); override
    # with OC_CUDA_MODULE=cuda/<version> if your cluster names it differently.
    # NB: the cluster's `cuda` (no version) default is 11.6.2 which is too
    # old for recent vllm.
    if [[ "$VLLM_DEVICE" == "cuda" ]]; then
        OC_CUDA_MODULE="${OC_CUDA_MODULE:-cuda/12.2.2}"
        if module load "$OC_CUDA_MODULE" 2>/dev/null; then
            LOG_PREFIX "  module load $OC_CUDA_MODULE  ok"
        else
            LOG_PREFIX "  WARN: module load $OC_CUDA_MODULE failed; relying on host cuda"
        fi
        if ! command -v nvidia-smi >/dev/null 2>&1 \
                || ! nvidia-smi -L >/dev/null 2>&1; then
            LOG_PREFIX "FATAL: no GPU visible on this node."
            LOG_PREFIX "  - Is the PBS job requesting a GPU? (e.g. -l select=1:ncpus=8:ngpus=1)"
            LOG_PREFIX "  - Is the cuda module loaded? (set OC_CUDA_MODULE=<your-module>)"
            LOG_PREFIX "  - Override with VLLM_DEVICE=cpu to force CPU."
            exit 2
        fi
        LOG_PREFIX "  nvidia-smi   = $(nvidia-smi -L | head -1)"
    fi

    # Build the vllm-serve flag list per profile.
    # Recent vllm dropped `--device` entirely — GPU images auto-detect cuda,
    # CPU images (vllm-openai-cpu) are CPU-only builds. Device choice now
    # drives sif selection + singularity --nv only.
    # `--gpu-memory-utilization` is accepted by both images (overloaded to
    # mean CPU-RAM utilization on the CPU build).
    VLLM_SERVE_FLAGS=(
        --host "${BIND_HOST:-0.0.0.0}" --port "$VLLM_PORT"
        --tensor-parallel-size "$VLLM_TP"
        --max-model-len "$VLLM_MAX_LEN"
        --trust-remote-code
        --enable-prefix-caching
        --gpu-memory-utilization "$VLLM_GPU_UTIL"
    )
    if [[ -n "${REASONING_PARSER:-}" ]]; then
        VLLM_SERVE_FLAGS+=(--reasoning-parser "$REASONING_PARSER")
    fi
    if [[ -n "${TOOL_CALL_PARSER:-}" ]]; then
        VLLM_SERVE_FLAGS+=(--enable-auto-tool-choice --tool-call-parser "$TOOL_CALL_PARSER")
    fi
    VLLM_SERVE_FLAGS+=(--max-num-seqs "${MAX_NUM_SEQS:-128}")

    SING_GPU_FLAG=()
    [[ "$VLLM_DEVICE" == "cuda" ]] && SING_GPU_FLAG=(--nv)

    LOG_PREFIX "  vllm device  = $VLLM_DEVICE"
    LOG_PREFIX "  vllm model   = $VLLM_MODEL"
    LOG_PREFIX "  vllm flags   = ${VLLM_SERVE_FLAGS[*]}"
    LOG_PREFIX "  --nv passed  = $([[ ${#SING_GPU_FLAG[@]} -gt 0 ]] && echo yes || echo no)"

    # --containall: full isolation (= --contain --cleanenv --no-home).
    # Without this, singularity bind-mounts $HOME by default; the host's
    # ~/.local/lib/python3.12/site-packages is then auto-added to sys.path
    # by the container's python and shadows the container's own packages
    # (transformers' version check failed because host's huggingface-hub
    # 1.12 was picked up over the container's bundled <1.0).
    # Bind the scratch cache root and the per-job tmpdir as the same paths
    # they have on the host so SINGULARITYENV_{TMPDIR,XDG_CACHE_HOME,HF_HOME,
    # TORCHINDUCTOR_CACHE_DIR,VLLM_CACHE_ROOT} resolve to real, writable dirs.
    singularity exec "${SING_GPU_FLAG[@]}" --containall \
        --bind "$SCRATCH/.cache:$SCRATCH/.cache:rw" \
        --bind "$OC_TMPDIR:$OC_TMPDIR:rw" \
        --bind "$LOG_DIR:/logs:rw" \
        "$VLLM_SIF" \
        vllm serve "$VLLM_MODEL" "${VLLM_SERVE_FLAGS[@]}" \
        > "$VLLM_LOG" 2>&1 &
    VLLM_PID=$!
    LOG_PREFIX "  vllm pid=$VLLM_PID, log=$VLLM_LOG"

    # Now that vllm has forked (it inherited these via the export), strip the
    # vllm-specific SINGULARITYENV_* vars from the parent shell so they don't
    # leak into stage 4's `singularity exec` for the OC gateway. The OC sif
    # only binds state_dir / workspace_base / plugin-cache, so a SINGULARITYENV_
    # TMPDIR pointing at $SCRATCH/.tmp/<jobid> makes node's os.tmpdir() resolve
    # to a path that doesn't exist inside the container — gateway then crashes
    # with `ENOENT, mkdir '/scratch/users/ntu/<user>/.tmp'`.
    unset SINGULARITYENV_TMPDIR \
          SINGULARITYENV_TORCHINDUCTOR_CACHE_DIR \
          SINGULARITYENV_HF_HOME \
          SINGULARITYENV_HUGGINGFACE_HUB_CACHE \
          SINGULARITYENV_XDG_CACHE_HOME \
          SINGULARITYENV_VLLM_CACHE_ROOT

    # Poll for ready
    DEADLINE=$(( $(date +%s) + 1800 ))
    until curl -fsS "http://127.0.0.1:$VLLM_PORT/v1/models" >/dev/null 2>&1; do
        if ! kill -0 "$VLLM_PID" 2>/dev/null; then
            LOG_PREFIX "FATAL: vllm exited; tail of log:"
            tail -50 "$VLLM_LOG"
            exit 3
        fi
        if [ "$(date +%s)" -ge "$DEADLINE" ]; then
            LOG_PREFIX "FATAL: vllm not ready after 1800s"
            tail -50 "$VLLM_LOG"
            kill "$VLLM_PID" 2>/dev/null || true
            exit 3
        fi
        sleep 10
    done
    LOG_PREFIX "  vllm ready on http://127.0.0.1:$VLLM_PORT"

    # Sidecar: poll vLLM's Prometheus /metrics endpoint at iteration cadence
    # (default 100ms) and emit JSONL with running/waiting sequence counts,
    # token throughput, and KV cache utilization. /metrics gauges update on
    # every scheduler step, so polling here gives true iteration-level
    # resolution — vLLM's stdout-log stats are rate-limited to 5-10s and
    # lose iteration granularity. Output joins with util_sampler.jsonl +
    # spans.jsonl on ts_ns during offline analysis.
    OC_ENGINE="${OC_ENGINE:-vllm}"
    ENGINE_METRICS_LOG="${OC_ENGINE_METRICS_LOG:-$LOG_DIR/engine_metrics.jsonl}"
    ENGINE_TAILER_LOG="$LOG_DIR/engine_log_tailer.log"
    OC_ENGINE_INTERVAL="${OC_ENGINE_INTERVAL:-0.1}"
    python3 "$KIT_ROOT/agent_bench/serving/engine_log_tailer.py" \
        --engine "$OC_ENGINE" \
        --source metrics \
        --base-url "http://127.0.0.1:$VLLM_PORT" \
        --interval "$OC_ENGINE_INTERVAL" \
        --output "$ENGINE_METRICS_LOG" \
        > "$ENGINE_TAILER_LOG" 2>&1 &
    ENGINE_TAILER_PID=$!
    LOG_PREFIX "  engine metrics tailer pid=$ENGINE_TAILER_PID -> $ENGINE_METRICS_LOG (interval=${OC_ENGINE_INTERVAL}s)"
fi

# ============================================================================
# Stage 3: build/pull agent runtime sif + OpenClaw patch/cache when needed
# ============================================================================
ensure_runtime_sif() {
    local label="$1" sif="$2" docker_ref="$3"
    local env_prefix="${4:-}"
    mkdir -p "$(dirname "$sif")"
    if [[ ! -f "$sif" ]]; then
        case "$docker_ref" in
            docker://agent-bench/*)
                LOG_PREFIX "FATAL: $label runtime sif missing: $sif"
                LOG_PREFIX "  $docker_ref is a local Docker tag, not a public registry image."
                LOG_PREFIX "  Prebuild/copy the SIF to $sif, or set a pullable remote image:"
                if [[ -n "$env_prefix" ]]; then
                    LOG_PREFIX "    -v ${env_prefix}_RUNTIME_SIF=$sif,${env_prefix}_RUNTIME_DOCKER=docker://<registry>/<image>:<tag>"
                fi
                exit 4
                ;;
        esac
        LOG_PREFIX "  pulling $label runtime: $docker_ref -> $sif"
        local pull_log="$LOG_DIR/runtime-${label//[^A-Za-z0-9._-]/_}-pull.log"
        if ! singularity pull --dir "$(dirname "$sif")" \
                --name "$(basename "$sif")" "$docker_ref" \
                > "$pull_log" 2>&1; then
            LOG_PREFIX "FATAL: failed to pull $label runtime from $docker_ref"
            LOG_PREFIX "  pull log: $pull_log"
            tail -40 "$pull_log" || true
            exit 4
        fi
        [[ -f "$sif" ]] || {
            LOG_PREFIX "FATAL: singularity pull completed but runtime sif is missing: $sif"
            exit 4
        }
    else
        LOG_PREFIX "  $label runtime sif already present at $sif"
    fi
}

export OC_SCORING_SIF_DIR="$SIF_DIR"

if [[ "$STAGE_OC_CHECK" == "1" ]]; then
    LOG_PREFIX "==== STAGE 3: ensure $HARNESS_CHOICE runtime sif ===="
    case "$HARNESS_CHOICE" in
        openclaw)
            ensure_runtime_sif "openclaw upstream" "$OC_RUNTIME_BASE_SIF" "$OC_RUNTIME_DOCKER" OC
            OC_BUILD_PATCHED=0
            if [[ ! -f "$OC_RUNTIME_SIF" ]]; then
                OC_BUILD_PATCHED=1
            elif [[ "$OC_RUNTIME_REBUILD" == "1" ]]; then
                OC_BUILD_PATCHED=1
            else
                if ! singularity exec \
                        --bind "$KIT_ROOT/agent_bench/harnesses/openclaw:/oc-harness:ro" \
                        "$OC_RUNTIME_SIF" \
                        bash -c "OC_HOST_OPENCLAW='$OC_INSIDE_PKG' OC_PATCH_MODE=baked python3 /oc-harness/apply_patch.py apply" \
                        >/dev/null 2>&1; then
                    LOG_PREFIX "  patched OpenClaw sif exists but patch markers are incomplete; rebuilding"
                    OC_BUILD_PATCHED=1
                fi
            fi
            if [[ "$OC_BUILD_PATCHED" == "1" ]]; then
                LOG_PREFIX "  building patched OpenClaw runtime sif at $OC_RUNTIME_SIF"
                bash "$KIT_ROOT/agent_bench/deployments/pbs/build_oc_sif.sh" \
                    --base "$OC_RUNTIME_BASE_SIF" \
                    --out "$OC_RUNTIME_SIF" \
                    --kit-root "$KIT_ROOT" \
                    --inside-pkg "$OC_INSIDE_PKG" \
                    || { LOG_PREFIX "FATAL: build_oc_sif.sh failed"; exit 4; }
            else
                LOG_PREFIX "  patched OpenClaw runtime sif already present at $OC_RUNTIME_SIF"
            fi
            export OC_OC_SIF="$OC_RUNTIME_SIF"
            if [[ -n "${OC_RUNTIME_OVERLAY:-}" ]]; then
                export OC_OC_OVERLAY="$OC_RUNTIME_OVERLAY"
            else
                unset OC_OC_OVERLAY
            fi
            ;;
        openhands)
            if [[ -n "$OH_RUNTIME_DOCKER" ]]; then
                ensure_runtime_sif "openhands" "$OH_RUNTIME_SIF" "$OH_RUNTIME_DOCKER" OH
            else
                ensure_runtime_sif "openhands base" "$OH_RUNTIME_BASE_SIF" "$OH_RUNTIME_BASE_DOCKER" OH
                if [[ ! -f "$OH_RUNTIME_SIF" || "$OH_RUNTIME_REBUILD" == "1" ]]; then
                    LOG_PREFIX "  building OpenHands runtime sif at $OH_RUNTIME_SIF"
                    bash "$KIT_ROOT/agent_bench/deployments/pbs/build_oh_sif.sh" \
                        --base "$OH_RUNTIME_BASE_SIF" \
                        --out "$OH_RUNTIME_SIF" \
                        --kit-root "$KIT_ROOT" \
                        --version "$OH_RUNTIME_VERSION" \
                        || { LOG_PREFIX "FATAL: build_oh_sif.sh failed"; exit 4; }
                else
                    LOG_PREFIX "  OpenHands runtime sif already present at $OH_RUNTIME_SIF"
                fi
            fi
            export OH_RUNTIME_SIF
            export OH_IMAGE="$OH_RUNTIME_SIF"
            ;;
        hermes)
            if [[ -n "$HM_RUNTIME_DOCKER" ]]; then
                ensure_runtime_sif "hermes" "$HM_RUNTIME_SIF" "$HM_RUNTIME_DOCKER" HM
            else
                ensure_runtime_sif "hermes upstream" "$HM_RUNTIME_BASE_SIF" "$HM_RUNTIME_BASE_DOCKER" HM
                if [[ ! -f "$HM_RUNTIME_SIF" || "$HM_RUNTIME_REBUILD" == "1" ]]; then
                    LOG_PREFIX "  building patched Hermes runtime sif at $HM_RUNTIME_SIF"
                    bash "$KIT_ROOT/agent_bench/deployments/pbs/build_hm_sif.sh" \
                        --base "$HM_RUNTIME_BASE_SIF" \
                        --out "$HM_RUNTIME_SIF" \
                        --kit-root "$KIT_ROOT" \
                        --version "$HM_RUNTIME_VERSION" \
                        || { LOG_PREFIX "FATAL: build_hm_sif.sh failed"; exit 4; }
                else
                    LOG_PREFIX "  patched Hermes runtime sif already present at $HM_RUNTIME_SIF"
                fi
            fi
            export HM_RUNTIME_SIF
            export HM_IMAGE="$HM_RUNTIME_SIF"
            ;;
        *)
            LOG_PREFIX "FATAL: unsupported harness_choice=$HARNESS_CHOICE"
            exit 4
            ;;
    esac
fi

if [[ "$STAGE_RUN" == "1" ]]; then
    case "$HARNESS_CHOICE" in
        openhands)
            if [[ ! -f "$OH_RUNTIME_SIF" ]]; then
                LOG_PREFIX "FATAL: OpenHands runtime sif missing: $OH_RUNTIME_SIF"
                LOG_PREFIX "  Set STAGE_OC_CHECK=1 to build it, prebuild/copy the SIF there, or set:"
                LOG_PREFIX "    -v OH_RUNTIME_SIF=<path>,OH_RUNTIME_DOCKER=docker://<registry>/<image>:<tag>"
                LOG_PREFIX "  Manual build:"
                LOG_PREFIX "    bash $KIT_ROOT/agent_bench/deployments/pbs/build_oh_sif.sh --base $OH_RUNTIME_BASE_SIF --out $OH_RUNTIME_SIF"
                exit 4
            fi
            ;;
        hermes)
            if [[ ! -f "$HM_RUNTIME_SIF" ]]; then
                LOG_PREFIX "FATAL: Hermes runtime sif missing: $HM_RUNTIME_SIF"
                LOG_PREFIX "  Set STAGE_OC_CHECK=1 to build it, prebuild/copy the SIF there, or set:"
                LOG_PREFIX "    -v HM_RUNTIME_SIF=<path>,HM_RUNTIME_DOCKER=docker://<registry>/<image>:<tag>"
                LOG_PREFIX "  Manual build:"
                LOG_PREFIX "    bash $KIT_ROOT/agent_bench/deployments/pbs/build_hm_sif.sh --base $HM_RUNTIME_BASE_SIF --out $HM_RUNTIME_SIF"
                exit 4
            fi
            ;;
    esac
fi

if [[ "$HARNESS_CHOICE" == "openclaw" ]]; then
    # Wire Singularity OpenClaw to the patched runtime sif. OC_RUNTIME_OVERLAY
    # is kept only as an escape hatch for prebuilt overlays; the NSCC default
    # is a patched sif because unprivileged overlays cannot write /app.
    export OC_OC_SIF="${OC_OC_SIF:-$OC_RUNTIME_SIF}"
    if [[ -n "${OC_OC_OVERLAY:-${OC_RUNTIME_OVERLAY:-}}" ]]; then
        export OC_OC_OVERLAY="${OC_OC_OVERLAY:-$OC_RUNTIME_OVERLAY}"
    else
        unset OC_OC_OVERLAY
    fi
    : "${OC_PLUGIN_CACHE:=$SCRATCH/oc-eval/plugin-cache}"
    export OC_PLUGIN_CACHE
    mkdir -p "$OC_PLUGIN_CACHE"

    # Direct egress to registry.npmjs.org is blocked from this cluster; route
    # the in-sif npm at the Taobao mirror. Override via OC_NPM_MIRROR if needed.
    NPM_MIRROR_URL="${OC_NPM_MIRROR:-https://registry.npmmirror.com}"
    LOG_PREFIX "  using npm registry mirror: $NPM_MIRROR_URL"
    export SINGULARITYENV_NPM_CONFIG_REGISTRY="$NPM_MIRROR_URL"
    export SINGULARITYENV_NODE_OPTIONS="--dns-result-order=ipv4first"

    OC_STATE_TEMPLATE_TMP="$(mktemp -d -t oc-state-XXXXXX)"
    trap 'rm -rf "$OC_STATE_TEMPLATE_TMP"' EXIT
    python3 - "$HARNESS_CONFIG" "$OC_STATE_TEMPLATE_TMP/openclaw.json" <<'PY'
import json
import os
import sys

harness_path, out_path = sys.argv[1], sys.argv[2]
with open(harness_path) as fh:
    harness = json.load(fh) or {}

oc_cfg = harness.get("openclaw") or {}
if not oc_cfg:
    raise SystemExit(f"harness config {harness_path} has no `openclaw` block")

model_name = os.environ.get("MODEL") or "Qwen/Qwen3.6-27B"
providers = oc_cfg.setdefault("models", {}).setdefault("providers", {})
vllm_provider = providers.setdefault("vllm", {})
vllm_provider["api"] = "openai-completions"
vllm_provider.setdefault("baseUrl", os.environ.get("MODEL_ENDPOINT", "http://127.0.0.1:8000/v1"))
vllm_provider.setdefault("apiKey", os.environ.get("MODEL_API_KEY") or "sk-dummy")
vllm_provider["models"] = [{
    "id": model_name,
    "name": model_name,
    "api": "openai-completions",
    "contextWindow": int(os.environ.get("MODEL_CONTEXT_WINDOW") or 0),
    "maxTokens": int(os.environ.get("MAX_TOKENS") or 8192),
}]
agents_defaults = oc_cfg.setdefault("agents", {}).setdefault("defaults", {})
agents_defaults.setdefault("model", {})["primary"] = f"vllm/{model_name}"

with open(out_path, "w") as fh:
    json.dump(oc_cfg, fh, indent=2)
PY
    mkdir -p "$OC_STATE_TEMPLATE_TMP/agents/swebench"
    cp "$KIT_ROOT/agent_bench/benchmarks/swebench/openclaw/agents/"*.md "$OC_STATE_TEMPLATE_TMP/agents/swebench/"

    if ! find "$OC_PLUGIN_CACHE" -mindepth 2 -name package.json -print -quit | grep -q .; then
        LOG_PREFIX "  plugin cache cold at $OC_PLUGIN_CACHE; warming..."
        OC_WARM_OVERLAY_ARGS=()
        if [[ -n "${OC_OC_OVERLAY:-}" ]]; then
            OC_WARM_OVERLAY_ARGS+=(--overlay "$OC_OC_OVERLAY")
        fi
        if bash "$KIT_ROOT/agent_bench/deployments/pbs/warm_oc_plugins.sh" \
                --sif "$OC_OC_SIF" \
                "${OC_WARM_OVERLAY_ARGS[@]}" \
                --cache "$OC_PLUGIN_CACHE" \
                --state-template "$OC_STATE_TEMPLATE_TMP"; then
            LOG_PREFIX "  plugin cache warmed"
        else
            LOG_PREFIX "FATAL: plugin cache warm failed."
            LOG_PREFIX "  Run on a node with internet access:"
            LOG_PREFIX "    bash $KIT_ROOT/agent_bench/deployments/pbs/warm_oc_plugins.sh \\"
            LOG_PREFIX "        --sif $OC_OC_SIF ${OC_OC_OVERLAY:+--overlay $OC_OC_OVERLAY} \\"
            LOG_PREFIX "        --cache $OC_PLUGIN_CACHE \\"
            LOG_PREFIX "        --state-template <generated openclaw.json + agent_bench/benchmarks/swebench/openclaw/agents>"
            exit 5
        fi
    else
        LOG_PREFIX "  plugin cache already warm at $OC_PLUGIN_CACHE"
    fi

    bash "$KIT_ROOT/agent_bench/deployments/pbs/oc_plugin_cache_clean.sh" \
        "$OC_PLUGIN_CACHE" "$OC_STATE_TEMPLATE_TMP/openclaw.json" \
        2>&1 | sed "s|^|$(date +%H:%M:%S) [run_benchmark] |" || true
fi

# ============================================================================
# Stage 3.5: start local OTel collector (optional but the only way spans.jsonl
# files get produced — the OC gateway emits OTLP/HTTP to 127.0.0.1:$OC_OTEL_PORT
# and openclaw_agent.py slices the resulting trace file into per-run jsonl).
# Best-effort: a failure here only loses telemetry, not the run itself.
# ============================================================================
if [[ "$STAGE_OTEL" == "1" ]]; then
    LOG_PREFIX "==== STAGE 3.5: start OTel collector ===="
    if bash "$KIT_ROOT/agent_bench/deployments/pbs/otel_collector.sh" start; then
        LOG_PREFIX "  OTel collector ready at 127.0.0.1:${OC_OTEL_PORT:-4318}"
        LOG_PREFIX "  trace file -> $OC_OTEL_TRACE_FILE"
    else
        LOG_PREFIX "  WARN: OTel collector failed to start; spans.jsonl will be missing"
        LOG_PREFIX "        (run continues — OC agent works without telemetry)"
    fi
fi

# ============================================================================
# Stage 4: run benchmark
# ============================================================================
RUN_RC=0
if [[ "$STAGE_RUN" == "1" ]]; then
    LOG_PREFIX "==== STAGE 4: run benchmark ===="
    export KIT_ROOT
    export HARNESS_BACKEND=singularity
    export OC_HOST_WORKSPACE_BASE="$SCRATCH/oc-eval/workspaces"
    mkdir -p "$OC_HOST_WORKSPACE_BASE"

    # Per-component CPU split: hand the serving sidecar pid to the sampler so
    # cpu.by_group in util.jsonl attributes engine/proxy work to "llm_engine".
    # Driver/gateway pids are picked up by the sampler from the live process tree.
    [[ -n "$VLLM_PID" ]] && export OC_LLM_PID="$VLLM_PID"
    [[ -n "$LITELLM_PID" ]] && export OC_LLM_PID="$LITELLM_PID"

    python3 -m agent_bench.runtime.driver \
        --app "$APP" \
        --harness "$HARNESS_CONFIG" \
        --model "$MODEL_CONFIG" \
        --serving "$SERVING_CONFIG" \
        --swebench-root "$SWEBENCH_ROOT" \
        --instance-data "$DATASET" \
        2>&1 | tee -a "$LOG_DIR/run.log"
    RUN_RC=${PIPESTATUS[0]}
    LOG_PREFIX "  driver exit rc=$RUN_RC"
fi

# ============================================================================
# Stage 5: cleanup
# ============================================================================
if [[ "$STAGE_CLEANUP" == "1" ]]; then
    LOG_PREFIX "==== STAGE 5: cleanup ===="
    # Stop OTel first so the file exporter flushes its remaining batches
    # while the agent's last spans are still being written. Order matters —
    # SIGTERM on otelcol triggers a graceful flush; SIGKILL would lose the
    # tail of the trace file.
    if [[ "$STAGE_OTEL" == "1" ]]; then
        bash "$KIT_ROOT/agent_bench/deployments/pbs/otel_collector.sh" stop || true
    fi
    # Stop the engine log tailer before vLLM so it captures the final scheduler
    # tick that fires as vLLM tears down. SIGTERM triggers a clean JSONL flush.
    if [[ -n "${ENGINE_TAILER_PID:-}" ]] && kill -0 "$ENGINE_TAILER_PID" 2>/dev/null; then
        LOG_PREFIX "  stopping engine log tailer pid=$ENGINE_TAILER_PID"
        kill -TERM "$ENGINE_TAILER_PID" 2>/dev/null || true
        for _ in {1..10}; do
            sleep 0.5
            kill -0 "$ENGINE_TAILER_PID" 2>/dev/null || break
        done
        kill -KILL "$ENGINE_TAILER_PID" 2>/dev/null || true
    fi
    if [[ -n "$VLLM_PID" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
        LOG_PREFIX "  stopping vllm pid=$VLLM_PID"
        kill -TERM "$VLLM_PID" 2>/dev/null || true
        for _ in {1..30}; do
            sleep 1
            kill -0 "$VLLM_PID" 2>/dev/null || break
        done
        kill -KILL "$VLLM_PID" 2>/dev/null || true
    fi
    if [[ -n "$LITELLM_PID" ]] && kill -0 "$LITELLM_PID" 2>/dev/null; then
        LOG_PREFIX "  stopping litellm pid=$LITELLM_PID"
        kill -TERM "$LITELLM_PID" 2>/dev/null || true
        for _ in {1..20}; do
            sleep 1
            kill -0 "$LITELLM_PID" 2>/dev/null || break
        done
        kill -KILL "$LITELLM_PID" 2>/dev/null || true
    fi
fi

LOG_PREFIX "==== done; rc=$RUN_RC ===="
exit $RUN_RC
