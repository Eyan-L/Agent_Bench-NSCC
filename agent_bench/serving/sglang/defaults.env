# Defaults for sglang agent_bench.serving. Override by exporting before sourcing.
# Required (no default): SGLANG_MODEL_PATH
: "${SGLANG_PORT:=30000}"
: "${SGLANG_HOST:=0.0.0.0}"
: "${SGLANG_MEM_FRACTION:=0.85}"
: "${SGLANG_TP:=1}"
: "${SGLANG_DP_SIZE:=1}"
: "${SGLANG_CACHE_MODE:=hiradix}"
: "${SGLANG_ENABLE_HIERARCHICAL_CACHE:=0}"
: "${SGLANG_HICACHE_SIZE:=60}"
: "${SGLANG_TOOL_PARSER:=}"
: "${SGLANG_PATCH_MODE:=bind}"           # bind | copy | baked | skip
: "${SGLANG_SITE_PACKAGES:=}"            # auto-detect if empty
: "${SGLANG_PATCH_DIR:=$(dirname "${BASH_SOURCE[0]}")/patch/sglang}"

export SGLANG_PORT SGLANG_HOST SGLANG_MEM_FRACTION SGLANG_TP SGLANG_DP_SIZE
export SGLANG_CACHE_MODE SGLANG_ENABLE_HIERARCHICAL_CACHE SGLANG_HICACHE_SIZE
export SGLANG_TOOL_PARSER SGLANG_PATCH_MODE
export SGLANG_SITE_PACKAGES SGLANG_PATCH_DIR
