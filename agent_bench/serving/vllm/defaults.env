# Defaults for vLLM agent_bench.serving.
: "${VLLM_PORT:=8000}"
: "${VLLM_HOST:=0.0.0.0}"
: "${VLLM_GPU_MEM_FRACTION:=0.85}"
: "${VLLM_TP_SIZE:=1}"
: "${VLLM_DTYPE:=auto}"
: "${VLLM_MAX_MODEL_LEN:=}"
: "${VLLM_TOOL_PARSER:=}"

export VLLM_PORT VLLM_HOST VLLM_GPU_MEM_FRACTION VLLM_TP_SIZE
export VLLM_DTYPE VLLM_MAX_MODEL_LEN VLLM_TOOL_PARSER
