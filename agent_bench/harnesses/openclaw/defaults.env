# OpenClaw frontend defaults. Override by exporting before sourcing.
# Required (no default): AB_HARNESS_NODE_BIN, AB_HARNESS_OPENCLAW_SOURCE_ROOT
: "${AB_HARNESS_NODE_BIN:=/usr/local/bin/node}"
: "${AB_HARNESS_OPENCLAW_SOURCE_ROOT:=/usr/local/lib/node_modules/openclaw}"
: "${AB_HARNESS_NPM_PACKAGE_ROOT:=/usr/local/lib/node_modules/npm}"
: "${AB_HARNESS_GATEWAY_PORT_MIN:=18800}"
: "${AB_HARNESS_GATEWAY_PORT_MAX:=18899}"
: "${AB_HARNESS_GATEWAY_PORT_STRIDE:=4}"
: "${AB_TELEMETRY_DATA_DIR:=/tmp/otel}"
: "${AB_TELEMETRY_TRACE_FILE:=${AB_TELEMETRY_DATA_DIR}/otel-traces.jsonl}"
: "${AB_TELEMETRY_FLUSH_WAIT_SECONDS:=1.5}"
: "${AB_HARNESS_OPENCLAW_PATCH_MODE:=runtime}"            # runtime | baked | skip
: "${AB_AGENT_RUNTIME_NAME:=swebench}"
: "${AB_HARNESS_PLUGIN_CACHE:=${HOME}/.cache/openclaw/plugin-deps}"

export AB_HARNESS_NODE_BIN AB_HARNESS_OPENCLAW_SOURCE_ROOT AB_HARNESS_NPM_PACKAGE_ROOT
export AB_HARNESS_GATEWAY_PORT_MIN AB_HARNESS_GATEWAY_PORT_MAX AB_HARNESS_GATEWAY_PORT_STRIDE
export AB_TELEMETRY_DATA_DIR AB_TELEMETRY_TRACE_FILE AB_TELEMETRY_FLUSH_WAIT_SECONDS
export AB_HARNESS_OPENCLAW_PATCH_MODE AB_AGENT_RUNTIME_NAME AB_HARNESS_PLUGIN_CACHE
