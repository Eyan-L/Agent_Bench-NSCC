# OpenClaw frontend defaults. Override by exporting before sourcing.
# Required (no default): OC_HOST_NODE, OC_HOST_OPENCLAW
: "${OC_HOST_NODE:=/usr/local/bin/node}"
: "${OC_HOST_OPENCLAW:=/usr/local/lib/node_modules/openclaw}"
: "${OC_HOST_NPM_PKG:=/usr/local/lib/node_modules/npm}"
: "${OC_GATEWAY_PORT_MIN:=18800}"
: "${OC_GATEWAY_PORT_MAX:=18899}"
: "${OC_GATEWAY_PORT_STRIDE:=4}"
: "${OC_OTEL_DATA_DIR:=/tmp/otel}"
: "${OC_OTEL_TRACE_FILE:=${OC_OTEL_DATA_DIR}/otel-traces.jsonl}"
: "${OC_OTEL_FLUSH_WAIT_SECONDS:=1.5}"
: "${OC_PATCH_MODE:=runtime}"            # runtime | baked | skip
: "${OC_AGENT_NAME:=swebench}"
: "${OC_PLUGIN_CACHE:=${HOME}/.cache/openclaw/plugin-deps}"

export OC_HOST_NODE OC_HOST_OPENCLAW OC_HOST_NPM_PKG
export OC_GATEWAY_PORT_MIN OC_GATEWAY_PORT_MAX OC_GATEWAY_PORT_STRIDE
export OC_OTEL_DATA_DIR OC_OTEL_TRACE_FILE OC_OTEL_FLUSH_WAIT_SECONDS
export OC_PATCH_MODE OC_AGENT_NAME OC_PLUGIN_CACHE
