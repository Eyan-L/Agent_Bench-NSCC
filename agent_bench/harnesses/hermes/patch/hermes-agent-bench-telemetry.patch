+# AB_HARNESS_HERMES_PATCH_TELEMETRY_BEGIN
+def _hm_ab_events_path() -> str:
+    return os.getenv("AB_AGENT_RUNTIME_EVENTS_FILE", "").strip()
+
+
+def _hm_ab_write_event(event: dict) -> None:
+    path = _hm_ab_events_path()
+    if not path:
+        return
+    try:
+        parent = os.path.dirname(path)
+        if parent:
+            os.makedirs(parent, exist_ok=True)
+        with open(path, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
+    except Exception:
+        logging.debug("Agent_Bench Hermes telemetry event write failed", exc_info=True)
+
+
+def _hm_ab_otel_endpoint() -> str:
+    endpoint = (
+        os.getenv("OTEL_EXPORTER_OTLP_ENDPOINT")
+        or os.getenv("AB_TELEMETRY_ENDPOINT")
+        or ""
+    ).strip().rstrip("/")
+    if not endpoint:
+        return ""
+    return endpoint if endpoint.endswith("/v1/traces") else f"{endpoint}/v1/traces"
+
+
+def _hm_ab_otel_value(value: object) -> dict:
+    if isinstance(value, bool):
+        return {"boolValue": value}
+    if isinstance(value, int):
+        return {"intValue": value}
+    if isinstance(value, float):
+        return {"doubleValue": value}
+    if isinstance(value, (list, tuple)):
+        return {"arrayValue": {"values": [_hm_ab_otel_value(item) for item in value]}}
+    if isinstance(value, dict):
+        return {"stringValue": json.dumps(value, ensure_ascii=False, sort_keys=True)}
+    return {"stringValue": str(value)}
+
+
+def _hm_ab_otel_attrs(values: dict) -> list[dict]:
+    return [
+        {"key": str(key), "value": _hm_ab_otel_value(value)}
+        for key, value in values.items()
+        if value is not None
+    ]
+
+
+def _hm_ab_resource_attrs(run_id: str) -> dict:
+    return {
+        "ab.run_id": run_id,
+        "oc.run_id": run_id,
+        "agent.run_id": run_id,
+        "hm.run_id": run_id,
+        "service.name": "agent-bench-hermes",
+    }
+
+
+def _hm_ab_post_otel_spans(spans: list[dict], run_id: str) -> None:
+    endpoint = _hm_ab_otel_endpoint()
+    if not endpoint or not run_id or not spans:
+        return
+    try:
+        trace_id = os.urandom(16).hex()
+        body = {
+            "resourceSpans": [{
+                "resource": {"attributes": _hm_ab_otel_attrs(_hm_ab_resource_attrs(run_id))},
+                "scopeSpans": [{
+                    "scope": {"name": "agent-bench-hermes"},
+                    "spans": [
+                        {
+                            "traceId": trace_id,
+                            "spanId": os.urandom(8).hex(),
+                            "name": span["name"],
+                            "kind": 1,
+                            "startTimeUnixNano": str(int(span.get("start_ns") or 0)),
+                            "endTimeUnixNano": str(int(span.get("end_ns") or span.get("start_ns") or 0)),
+                            "attributes": _hm_ab_otel_attrs(span.get("attrs") or {}),
+                        }
+                        for span in spans
+                    ],
+                }],
+            }],
+        }
+        req = urllib.request.Request(
+            endpoint,
+            data=json.dumps(body, ensure_ascii=False).encode("utf-8"),
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urllib.request.urlopen(req, timeout=1.0):
+            pass
+    except Exception:
+        logging.debug("Agent_Bench Hermes OTLP export failed", exc_info=True)
+
+
+def _hm_ab_emit_otel_span(
+    name: str,
+    start_ns: int,
+    end_ns: int,
+    attrs: dict,
+    run_id: str,
+) -> None:
+    span_attrs = {
+        "agent.canonical_name": name,
+        "agent.run_id": run_id,
+        "agent.session_id": run_id,
+        "agent.span.source": "hermes.telemetry_patch",
+    }
+    span_attrs.update(attrs)
+    _hm_ab_post_otel_spans([{
+        "name": name,
+        "start_ns": start_ns,
+        "end_ns": end_ns,
+        "attrs": span_attrs,
+    }], run_id)
+
+
+def _hm_ab_json_preview(value: object, limit: int = 8192) -> tuple[str, bool, int]:
+    try:
+        text = json.dumps(value, ensure_ascii=False, sort_keys=True, default=str)
+    except Exception:
+        text = str(value)
+    original_len = len(text)
+    if original_len > limit:
+        return text[:limit], True, original_len
+    return text, False, original_len
+
+
+def _hm_ab_schema_expects_compound(schema: object) -> tuple[bool, bool]:
+    if not isinstance(schema, dict):
+        return False, False
+    typ = schema.get("type")
+    types = set()
+    if isinstance(typ, str):
+        types.add(typ)
+    elif isinstance(typ, list):
+        types.update(t for t in typ if isinstance(t, str))
+    expects_object = "object" in types
+    expects_array = "array" in types
+    for key in ("anyOf", "oneOf", "allOf"):
+        variants = schema.get(key)
+        if not isinstance(variants, list):
+            continue
+        for variant in variants:
+            v_obj, v_arr = _hm_ab_schema_expects_compound(variant)
+            expects_object = expects_object or v_obj
+            expects_array = expects_array or v_arr
+    return expects_object, expects_array
+
+
+def _hm_ab_coerce_json_string_args(tool_name: str, args: object) -> int:
+    """Coerce JSON-stringified object/array tool args before execution.
+
+    Some OpenAI-compatible parsers hand back nested object/array arguments as
+    JSON strings. Mirror OpenClaw's validation patch at the Hermes oneshot
+    boundary: consult the registered tool schema and parse only fields whose
+    schema expects an object or array. Best-effort: leave values unchanged on
+    parse/type mismatch.
+    """
+    if not isinstance(args, dict):
+        return 0
+    try:
+        from tools.registry import registry
+
+        schema = registry.get_schema(tool_name) or {}
+    except Exception:
+        schema = {}
+    params = schema.get("parameters") if isinstance(schema, dict) else None
+    props = params.get("properties") if isinstance(params, dict) else None
+    if not isinstance(props, dict):
+        return 0
+
+    coerced = 0
+    for key, value in list(args.items()):
+        if not isinstance(value, str):
+            continue
+        prop = props.get(key)
+        expects_object, expects_array = _hm_ab_schema_expects_compound(prop)
+        if not (expects_object or expects_array):
+            continue
+        raw = value.strip()
+        if not raw or raw[0] not in "[{":
+            continue
+        try:
+            parsed = json.loads(raw)
+        except Exception:
+            continue
+        if expects_object and isinstance(parsed, dict):
+            args[key] = parsed
+            coerced += 1
+        elif expects_array and isinstance(parsed, list):
+            args[key] = parsed
+            coerced += 1
+    return coerced
+
+
+def _hm_ab_tool_result_is_error(tool_name: str, result: object) -> bool:
+    try:
+        from agent.display import _detect_tool_failure
+
+        is_error, _ = _detect_tool_failure(tool_name, result)
+        return bool(is_error)
+    except Exception:
+        if isinstance(result, str):
+            lowered = result.lower()
+            return '\"error\"' in lowered or lowered.startswith("error")
+        return False
+
+
+def _hm_ab_attach_agent_bench_telemetry(agent):
+    if not _hm_ab_events_path() and not _hm_ab_otel_endpoint():
+        return None
+
+    run_id = os.getenv("AB_RUN_ID") or os.getenv("HERMES_RUN_ID") or os.getenv("OPENCLAW_RUN_ID") or ""
+    session_id = str(getattr(agent, "session_id", "") or run_id)
+    starts: dict[str, int] = {}
+    prior_start = getattr(agent, "tool_start_callback", None)
+    prior_complete = getattr(agent, "tool_complete_callback", None)
+
+    def on_tool_start(call_id, tool_name, args):
+        coerced = _hm_ab_coerce_json_string_args(str(tool_name or ""), args)
+        now_ns = time.time_ns()
+        key = str(call_id or f"{tool_name}:{now_ns}")
+        starts[key] = now_ns
+        emit_model_usage_delta(now_ns)
+        _hm_ab_write_event({
+            "type": "tool.start",
+            "ts_ns": now_ns,
+            "run_id": run_id,
+            "session_id": session_id,
+            "tool_name": str(tool_name or "unknown"),
+            "tool_call_id": key,
+            "args_coerced": coerced,
+        })
+        if prior_start:
+            prior_start(call_id, tool_name, args)
+
+    def on_tool_complete(call_id, tool_name, args, result):
+        end_ns = time.time_ns()
+        key = str(call_id or f"{tool_name}:{end_ns}")
+        start_ns = starts.pop(key, end_ns)
+        tool_event = {
+            "type": "tool.call",
+            "start_ns": start_ns,
+            "end_ns": end_ns,
+            "duration_ms": max((end_ns - start_ns) / 1e6, 0.0),
+            "run_id": run_id,
+            "session_id": session_id,
+            "tool_name": str(tool_name or "unknown"),
+            "tool_call_id": key,
+            "is_error": _hm_ab_tool_result_is_error(str(tool_name or ""), result),
+            "result_chars": len(str(result)) if result is not None else 0,
+        }
+        _hm_ab_write_event(tool_event)
+        args_json, args_truncated, _args_chars = _hm_ab_json_preview(args)
+        result_preview, result_truncated, result_chars = _hm_ab_json_preview(result, limit=4096)
+        _hm_ab_emit_otel_span(
+            "agent.tool.call",
+            start_ns,
+            end_ns,
+            {
+                "agent.channel": "hermes.oneshot",
+                "agent.tool.name": tool_event["tool_name"],
+                "agent.tool.call_id": key,
+                "agent.tool.callId": key,
+                "agent.tool.is_error": tool_event["is_error"],
+                "agent.tool.isError": tool_event["is_error"],
+                "agent.tool.arguments_json": args_json,
+                "agent.tool.arguments_truncated": args_truncated,
+                "agent.tool.result_preview": result_preview,
+                "agent.tool.result_chars": result_chars,
+                "agent.tool.result_truncated": result_truncated,
+            },
+            run_id,
+        )
+        if prior_complete:
+            prior_complete(call_id, tool_name, args, result)
+
+    agent.tool_start_callback = on_tool_start
+    agent.tool_complete_callback = on_tool_complete
+
+    def usage_snapshot() -> dict:
+        prompt_tokens = int(getattr(agent, "session_prompt_tokens", 0) or 0)
+        completion_tokens = int(getattr(agent, "session_completion_tokens", 0) or 0)
+        input_tokens = int(getattr(agent, "session_input_tokens", 0) or 0)
+        output_tokens = int(getattr(agent, "session_output_tokens", 0) or 0)
+        cache_read = int(getattr(agent, "session_cache_read_tokens", 0) or 0)
+        cache_write = int(getattr(agent, "session_cache_write_tokens", 0) or 0)
+        total_tokens = int(getattr(agent, "session_total_tokens", 0) or 0)
+        if input_tokens == 0:
+            input_tokens = prompt_tokens
+        if output_tokens == 0:
+            output_tokens = completion_tokens
+        if total_tokens == 0:
+            total_tokens = input_tokens + output_tokens
+        return {
+            "input_tokens": input_tokens,
+            "output_tokens": output_tokens,
+            "prompt_tokens": prompt_tokens,
+            "completion_tokens": completion_tokens,
+            "cache_read_tokens": cache_read,
+            "cache_write_tokens": cache_write,
+            "total_tokens": total_tokens,
+            "api_calls": int(getattr(agent, "session_api_calls", 0) or 0),
+        }
+
+    usage_last = usage_snapshot()
+    usage_last_ns = time.time_ns()
+    usage_events_written = 0
+
+    def emit_model_usage_delta(end_ns: int, *, force: bool = False) -> None:
+        nonlocal usage_last, usage_last_ns, usage_events_written
+        current = usage_snapshot()
+        delta = {
+            key: max(int(current.get(key, 0) or 0) - int(usage_last.get(key, 0) or 0), 0)
+            for key in current
+        }
+        has_usage = any(delta.get(key, 0) for key in (
+            "input_tokens", "output_tokens", "cache_read_tokens",
+            "cache_write_tokens", "total_tokens", "api_calls",
+        ))
+        if not has_usage and (not force or usage_events_written > 0):
+            return
+        usage_events_written += 1
+        start_ns = usage_last_ns or end_ns
+        usage_event = {
+            "type": "model.usage",
+            "channel": "hermes.llm",
+            "start_ns": start_ns,
+            "end_ns": end_ns,
+            "duration_ms": max((end_ns - start_ns) / 1e6, 0.0),
+            "request_index": usage_events_written,
+            "run_id": run_id,
+            "session_id": session_id,
+            "provider": str(getattr(agent, "provider", "") or ""),
+            "model": str(getattr(agent, "model", "") or ""),
+            "api": "hermes.chat",
+            **delta,
+        }
+        _hm_ab_write_event(usage_event)
+        _hm_ab_emit_otel_span(
+            "agent.model.usage",
+            start_ns,
+            end_ns,
+            {
+                "agent.channel": "hermes.llm",
+                "agent.provider": usage_event["provider"],
+                "agent.model": usage_event["model"],
+                "agent.api": "hermes.chat",
+                "agent.llm.request_index": usage_events_written,
+                "agent.llm.requestIndex": usage_events_written,
+                "agent.tokens.input": delta["input_tokens"],
+                "agent.tokens.output": delta["output_tokens"],
+                "agent.tokens.cache_read": delta["cache_read_tokens"],
+                "agent.tokens.cache_write": delta["cache_write_tokens"],
+                "agent.tokens.total": delta["total_tokens"],
+                "agent.api_calls": delta["api_calls"],
+            },
+            run_id,
+        )
+        usage_last = current
+        usage_last_ns = end_ns
+
+    def emit_model_usage(start_ns: int, end_ns: int) -> None:
+        nonlocal usage_last_ns
+        if not usage_last_ns:
+            usage_last_ns = start_ns
+        emit_model_usage_delta(end_ns, force=True)
+
+    return emit_model_usage
+# AB_HARNESS_HERMES_PATCH_TELEMETRY_END
