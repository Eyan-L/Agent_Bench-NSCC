+    @staticmethod
+    def _env_args_to_dict(env_args: list[str]) -> dict[str, str]:
+        """Convert docker exec -e KEY=VALUE args into a bridge env dict."""
+        env: dict[str, str] = {}
+        idx = 0
+        while idx < len(env_args):
+            if env_args[idx] == "-e" and idx + 1 < len(env_args):
+                item = env_args[idx + 1]
+                if "=" in item:
+                    key, value = item.split("=", 1)
+                    env[key] = value
+            idx += 2
+        return env
