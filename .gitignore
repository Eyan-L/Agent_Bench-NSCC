# Local environment / secrets — never commit
.env
.env.local
.env.*.local

# DR-Bench vendor — reference reports (15 MB); re-fetched by `make dr-vendor`
applications/deepresearch_bench/eval/vendor/data/test_data/

data/*

# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# OpenClaw runtime state under frontend/openclaw/state/ (only the agent profile files
# and openclaw.json are checked in; everything else is per-run scratch).
frontend/openclaw/state/logs/
frontend/openclaw/state/agents/*/sessions/
frontend/openclaw/state/agents/*/memory/
frontend/openclaw/state/agents/main/
logs/*