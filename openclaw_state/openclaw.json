{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "env",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    }
  },
  "diagnostics": {
    "enabled": true,
    "otel": {
      "enabled": true,
      "endpoint": "http://localhost:4318",
      "protocol": "http/protobuf",
      "serviceName": "agent-bench-openclaw",
      "traces": true,
      "metrics": true,
      "logs": true,
      "sampleRate": 1,
      "flushIntervalMs": 20
    },
    "cacheTrace": {
      "enabled": true,
      "includeMessages": true,
      "includePrompt": true,
      "includeSystem": true
    }
  },
  "tools": {
    "exec": {
      "host": "node",
      "security": "full"
    },
    "alsoAllow": ["sessions_spawn", "sessions_yield", "subagents"]
  },
  "plugins": {
    "entries": {
      "vllm":             {"enabled": true},
      "memory-core":      {"enabled": true},
      "diagnostics-otel": {"enabled": true},
      "litellm":          {"enabled": false},
      "anthropic":        {"enabled": false},
      "openrouter":       {"enabled": false}
    }
  },
  "models": {
    "providers": {
      "vllm": {
        "baseUrl": "http://localhost:8000/v1",
        "apiKey": "sk-dummy",
        "models": [
          {
            "id": "Qwen/Qwen3.6-35B-A3B",
            "name": "Qwen 3.6 35B A3B"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/testbed",
      "model": {
        "primary": "vllm/Qwen/Qwen3.6-35B-A3B"
      },
      "subagents": {
        "maxConcurrent": 4,
        "runTimeoutSeconds": 600
      }
    },
    "list": [
      {
        "id": "swebench",
        "default": true,
        "name": "swebench-coder"
      }
    ]
  }
}
