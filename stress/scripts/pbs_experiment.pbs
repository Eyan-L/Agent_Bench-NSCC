#!/usr/bin/env bash
#PBS -N agent_bench
#PBS -j oe
#PBS -o experiment/pbs_experiment.log
#
# Submit example (1 node, 4 H100 GPUs, 4 hours):
#
#   qsub -l select=1:ncpus=32:ngpus=4:mem=128gb -l walltime=04:00:00 \
#        -v EXP_CONFIG=config/stress/alibaba_nscc_2a_singularity.json \
#        run/pbs_experiment.pbs
#
# The PBS -v EXP_CONFIG=<path> env variable picks which experiment config
# to run. The rest of the parameters (GPUs, sglang knobs, loadgen args,
# plots) live inside that JSON.
set -euo pipefail

# PBS copies the script to a spool dir, so $0 is not the original path.
# Use PBS_O_WORKDIR (the directory from which qsub was submitted).
PROJECT_ROOT="${PBS_O_WORKDIR}"
cd "${PROJECT_ROOT}"

# ---------- env prep ----------
# Go is needed to build loadgen / experiment-bin.
module load go 2>/dev/null || true

# HF cache — change to wherever you've staged the model weights on NSCC.
# (The singularity launcher same-path binds this dir into the container and
# forwards HF_HOME via --env, so sglang resolves HF model names offline.)
export HF_HOME="${HF_HOME:-/scratch/users/ntu/${USER}/models}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

# ---------- build Go binaries ----------
GOPATH_DIR="${GOPATH_DIR:-${HOME}/go}"
GOCACHE_DIR="${GOCACHE_DIR:-${HOME}/.cache/go-build}"
GO_BIN="${GO_BIN:-$(command -v go)}"

echo "[pbs] building loadgen + experiment-bin"
GOPATH="${GOPATH_DIR}" GOCACHE="${GOCACHE_DIR}" \
    "${GO_BIN}" build -C loadgen -o loadgen-bin ./cmd/loadgen
GOPATH="${GOPATH_DIR}" GOCACHE="${GOCACHE_DIR}" \
    "${GO_BIN}" build -C run/experiment -o experiment-bin ./cmd/experiment

# ---------- run ----------
CONFIG="${EXP_CONFIG:-config/stress/alibaba_nscc_2a_singularity.json}"
echo "[pbs] config: ${CONFIG}"
echo "[pbs] HF_HOME=${HF_HOME}"
echo "[pbs] host: $(hostname)  GPUs: ${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi -L || true

exec ./run/experiment/experiment-bin -config "${CONFIG}"
