#!/bin/bash
# bench profile (Qwen3.6-35B-A3B, tp=4) needs 4 GPUs.
# This script runs the Terminal-Bench 2 sweep (kv-store-grpc by default).
# It is a sibling of pbs/run_benchmark.pbs — most of the vLLM stage is
# copied verbatim because it's identical between SWE-bench and TB.
#
#PBS -l select=1:ncpus=1:ngpus=4:mem=64gb
#PBS -l walltime=08:00:00
#PBS -q normal
#PBS -j oe
#PBS -N oc_tb_bench
#PBS -o /home/users/ntu/n2505289/Agent_Bench/data/logs/pbs_tb.log
#
# Stages (each can be skipped via env flag):
#   0. STAGE_TB_PULL=1   — singularity pull the TB task .sif from docker hub
#                          (one-time per docker tag; cached under $OC_TB_SIF_DIR)
#   1. STAGE_TB_DATA=1   — materialize $DATASET from vendored TB tasks/
#   2. STAGE_VLLM=1      — start vLLM singularity, serve Qwen3.6
#   3. STAGE_RUN=1       — invoke orchestration/runner/driver against the TB sweep
#   4. STAGE_CLEANUP=1   — kill vLLM
#
# Env (override via `qsub -v K1=V1,K2=V2 ...`):
#   KIT_ROOT       — repo root
#   APP            — application JSON (default: $KIT_ROOT/config/application/terminal_bench/kv_store.json)
#   HARNESS_CONFIG — harness JSON     (default: $KIT_ROOT/config/harness/tb_react_27b.json)
#   BACKEND_CONFIG — backend JSON     (default: $KIT_ROOT/config/backend/vllm/tp1.json)
#   TB_TASK_IDS    — space-separated TB task ids; default = all under
#                    config/benchmarks/terminal_bench/
#   DATASET        — path to materialized TB instance JSON
#   OC_TB_SIF_DIR  — where TB task .sifs land (default $SCRATCH/tb-sif)

set -uo pipefail

# ---- Resolve paths ---------------------------------------------------------
USER_NAME="${USER:-$(whoami)}"
SCRATCH="/scratch/users/ntu/$USER_NAME"
HOME="/home/users/ntu/${USER_NAME}"
PBS_O_WORKDIR=${SCRATCH}/github/Agent_Bench
KIT_ROOT="${KIT_ROOT:-${PBS_O_WORKDIR:-$HOME/Agent_Bench}}"

APP="${APP:-$KIT_ROOT/config/application/terminal_bench/kv_store.json}"
HARNESS_CONFIG="${HARNESS_CONFIG:-$KIT_ROOT/config/harness/tb_react_27b.json}"
BACKEND_CONFIG="${BACKEND_CONFIG:-$KIT_ROOT/config/backend/vllm/tp1.json}"
DATASET="${DATASET:-$KIT_ROOT/data/terminal_bench/tasks.json}"

OC_TB_SIF_DIR="${OC_TB_SIF_DIR:-$SCRATCH/tb-sif}"
SINGULARITY_CACHE="${SINGULARITY_CACHE:-$SCRATCH/.singularity}"

# vLLM bench profile defaults — same as run_benchmark.pbs.
VLLM_DEVICE="${VLLM_DEVICE:-cuda}"
VLLM_MODEL="${VLLM_MODEL:-Qwen/Qwen3.6-35B-A3B}"
VLLM_TP="${VLLM_TP:-4}"
VLLM_MAX_LEN="${VLLM_MAX_LEN:-32768}"
VLLM_PORT="${VLLM_PORT:-8000}"
VLLM_GPU_UTIL="${VLLM_GPU_UTIL:-0.93}"
VLLM_SIF="${VLLM_SIF:-$SCRATCH/sif_images/vllm_openai_cu128.sif}"
VLLM_DOCKER="${VLLM_DOCKER:-docker://vllm/vllm-openai:latest}"

STAGE_TB_PULL="${STAGE_TB_PULL:-1}"
STAGE_TB_DATA="${STAGE_TB_DATA:-1}"
STAGE_VLLM="${STAGE_VLLM:-1}"
STAGE_RUN="${STAGE_RUN:-1}"
STAGE_CLEANUP="${STAGE_CLEANUP:-1}"

OC_PYLIB="${OC_PYLIB:-$SCRATCH/pylib}"
OC_PIP_CACHE="${OC_PIP_CACHE:-$SCRATCH/.pip-cache}"

LOG_DIR="${OC_LOG_DIR:-$KIT_ROOT/logs}"
export OC_LOG_DIR="$LOG_DIR"
mkdir -p "$LOG_DIR" "$OC_TB_SIF_DIR" "$SINGULARITY_CACHE"
cd "$KIT_ROOT"

LOG_PREFIX() { echo "[$(date -u +%FT%TZ)] $*"; }

LOG_PREFIX "kit_root      = $KIT_ROOT"
LOG_PREFIX "app           = $APP"
LOG_PREFIX "harness       = $HARNESS_CONFIG"
LOG_PREFIX "backend       = $BACKEND_CONFIG"
LOG_PREFIX "dataset       = $DATASET"
LOG_PREFIX "tb_sif_dir    = $OC_TB_SIF_DIR"
LOG_PREFIX "vllm          = device=$VLLM_DEVICE model=$VLLM_MODEL tp=$VLLM_TP max_len=$VLLM_MAX_LEN"
LOG_PREFIX "stages: tb_pull=$STAGE_TB_PULL tb_data=$STAGE_TB_DATA vllm=$STAGE_VLLM run=$STAGE_RUN cleanup=$STAGE_CLEANUP"

module load singularity 2>/dev/null || LOG_PREFIX "WARN: 'module load singularity' failed; assuming binary on PATH"
command -v singularity >/dev/null 2>&1 || { LOG_PREFIX "FATAL: singularity not found"; exit 1; }
export SINGULARITY_CACHEDIR="$SINGULARITY_CACHE"

module load python/3.12.1-gcc11 2>/dev/null || module load python 2>/dev/null || true
command -v python3 >/dev/null 2>&1 || { LOG_PREFIX "FATAL: python3 not found"; exit 1; }

# Make `eval` a Python package importable from $KIT_ROOT.
export PYTHONPATH="$KIT_ROOT:$OC_PYLIB:${PYTHONPATH:-}"
export OC_TB_SIF_DIR

# ============================================================================
# Stage 0: pull TB task .sif images (idempotent — only pulls if missing).
# Done via the Python harness so the same image-resolver runs as in execute_run.
# ============================================================================
if [[ "$STAGE_TB_PULL" == "1" ]]; then
    LOG_PREFIX "==== STAGE 0: pull TB task .sif images ===="
    OC_TB_SIF_DIR="$OC_TB_SIF_DIR" python3 - <<'PY' || { LOG_PREFIX "FATAL: TB sif pull failed"; exit 1; }
import os, sys
from pathlib import Path
from applications.terminal_bench import loader
from applications.terminal_bench.app import TerminalBenchHarness

ids = os.environ.get("TB_TASK_IDS", "").split() or loader.list_task_ids()
if not ids:
    print("no TB tasks under config/benchmarks/terminal_bench/", file=sys.stderr)
    sys.exit(1)

h = TerminalBenchHarness()
for task_id in ids:
    inst = loader.load_task(task_id)
    img = inst["docker_image"]
    sif = h._ensure_sif(img)
    print(f"  {task_id}: {img} -> {sif}")
print(f"  pulled/cached {len(ids)} TB task sif(s)")
PY
fi

# ============================================================================
# Stage 1: materialize TB dataset JSON for the driver to consume.
# ============================================================================
if [[ "$STAGE_TB_DATA" == "1" ]]; then
    LOG_PREFIX "==== STAGE 1: materialize TB dataset $DATASET ===="
    mkdir -p "$(dirname "$DATASET")"
    TB_TASK_IDS_VAR="${TB_TASK_IDS:-}" \
    OC_TB_DATASET_OUT="$DATASET" \
    python3 - <<'PY' || { LOG_PREFIX "FATAL: TB dataset materialize failed"; exit 1; }
import os
from pathlib import Path
from applications.terminal_bench import loader

ids = os.environ.get("TB_TASK_IDS_VAR", "").split() or loader.list_task_ids()
out = Path(os.environ["OC_TB_DATASET_OUT"])
loader.materialize_dataset(ids, out)
print(f"  wrote {len(ids)} TB tasks -> {out}")
PY
fi

# ============================================================================
# Stage 2: vLLM singularity (verbatim from run_benchmark.pbs)
# ============================================================================
VLLM_LOG="$LOG_DIR/vllm.log"
VLLM_PID=""
if [[ "$STAGE_VLLM" == "1" ]]; then
    LOG_PREFIX "==== STAGE 2: start vLLM singularity (device=$VLLM_DEVICE) ===="
    if [[ ! -f "$VLLM_SIF" ]]; then
        LOG_PREFIX "  vllm sif not found; pulling $VLLM_DOCKER"
        mkdir -p "$(dirname "$VLLM_SIF")"
        if ! singularity pull "$VLLM_SIF" "$VLLM_DOCKER" >>"$LOG_DIR/vllm-pull.log" 2>&1; then
            LOG_PREFIX "FATAL: singularity pull failed"; tail -30 "$LOG_DIR/vllm-pull.log"; exit 2
        fi
    fi
    : > "$VLLM_LOG"
    OC_TMPDIR="${OC_TMPDIR:-$SCRATCH/.tmp/$PBS_JOBID}"
    mkdir -p "$OC_TMPDIR" "$SCRATCH/.cache/huggingface" "$SCRATCH/.cache/torchinductor" \
             "$SCRATCH/.cache/triton" "$SCRATCH/.cache/vllm" "$SCRATCH/.cache/vllm/modelinfos"
    export SINGULARITYENV_TMPDIR="$OC_TMPDIR"
    export SINGULARITYENV_TORCHINDUCTOR_CACHE_DIR="$SCRATCH/.cache/torchinductor"
    export SINGULARITYENV_HF_HOME="$SCRATCH/.cache/huggingface"
    export SINGULARITYENV_HUGGINGFACE_HUB_CACHE="$SCRATCH/.cache/huggingface"
    export SINGULARITYENV_XDG_CACHE_HOME="$SCRATCH/.cache"
    export SINGULARITYENV_VLLM_CACHE_ROOT="$SCRATCH/.cache/vllm"
    export SINGULARITYENV_TRITON_CACHE_DIR="$SCRATCH/.cache/triton"
    export SINGULARITYENV_TRITON_HOME="$SCRATCH/.cache/triton"

    if [[ "$VLLM_DEVICE" == "cuda" ]]; then
        OC_CUDA_MODULE="${OC_CUDA_MODULE:-cuda/12.2.2}"
        module load "$OC_CUDA_MODULE" 2>/dev/null || LOG_PREFIX "  WARN: cuda module load failed"
        nvidia-smi -L >/dev/null 2>&1 || { LOG_PREFIX "FATAL: no GPU visible"; exit 2; }
    fi

    VLLM_SERVE_FLAGS=(
        --host 0.0.0.0 --port "$VLLM_PORT"
        --tensor-parallel-size "$VLLM_TP"
        --max-model-len "$VLLM_MAX_LEN"
        --trust-remote-code
        --enable-prefix-caching
        --gpu-memory-utilization "$VLLM_GPU_UTIL"
        --reasoning-parser qwen3
        --enable-auto-tool-choice
        --tool-call-parser qwen3_coder
        --max-num-seqs 128
    )

    SING_GPU_FLAG=()
    [[ "$VLLM_DEVICE" == "cuda" ]] && SING_GPU_FLAG=(--nv)

    singularity exec "${SING_GPU_FLAG[@]}" --containall \
        --bind "$SCRATCH/.cache:$SCRATCH/.cache:rw" \
        --bind "$OC_TMPDIR:$OC_TMPDIR:rw" \
        --bind "$KIT_ROOT/logs:/logs" \
        "$VLLM_SIF" \
        vllm serve "$VLLM_MODEL" "${VLLM_SERVE_FLAGS[@]}" \
        > "$VLLM_LOG" 2>&1 &
    VLLM_PID=$!
    LOG_PREFIX "  vllm pid=$VLLM_PID, log=$VLLM_LOG"

    # Strip vllm-only SINGULARITYENV vars so they don't leak into TB
    # singularity exec calls (TB_TMPDIR etc would mismatch the task container).
    unset SINGULARITYENV_TMPDIR \
          SINGULARITYENV_TORCHINDUCTOR_CACHE_DIR \
          SINGULARITYENV_HF_HOME \
          SINGULARITYENV_HUGGINGFACE_HUB_CACHE \
          SINGULARITYENV_XDG_CACHE_HOME \
          SINGULARITYENV_VLLM_CACHE_ROOT \
          SINGULARITYENV_TRITON_CACHE_DIR \
          SINGULARITYENV_TRITON_HOME

    DEADLINE=$(( $(date +%s) + 1800 ))
    until curl -fsS "http://127.0.0.1:$VLLM_PORT/v1/models" >/dev/null 2>&1; do
        if ! kill -0 "$VLLM_PID" 2>/dev/null; then
            LOG_PREFIX "FATAL: vllm exited; tail of log:"; tail -50 "$VLLM_LOG"; exit 3
        fi
        if [ "$(date +%s)" -ge "$DEADLINE" ]; then
            LOG_PREFIX "FATAL: vllm not ready after 1800s"; tail -50 "$VLLM_LOG"
            kill "$VLLM_PID" 2>/dev/null || true; exit 3
        fi
        sleep 10
    done
    LOG_PREFIX "  vllm ready on http://127.0.0.1:$VLLM_PORT"
fi

# ============================================================================
# Stage 3: run TB driver
# ============================================================================
RUN_RC=0
if [[ "$STAGE_RUN" == "1" ]]; then
    LOG_PREFIX "==== STAGE 3: run TB benchmark ===="
    export OC_HOST_WORKSPACE_BASE="$SCRATCH/oc-eval/workspaces"
    mkdir -p "$OC_HOST_WORKSPACE_BASE"
    # SWE-bench root only used for legacy harness path checks; TB harness ignores it.
    SWEBENCH_ROOT="${SWEBENCH_ROOT:-$OC_PYLIB}"

    # Per-component CPU split: hand vLLM's pid to the sampler so cpu.by_group
    # in util.jsonl attributes engine work to "llm_engine".
    [[ -n "$VLLM_PID" ]] && export OC_LLM_PID="$VLLM_PID"

    python3 -m orchestration.runner.driver \
        --app "$APP" \
        --harness "$HARNESS_CONFIG" \
        --backend "$BACKEND_CONFIG" \
        --swebench-root "$SWEBENCH_ROOT" \
        --instance-data "$DATASET" \
        2>&1 | tee -a "$LOG_DIR/run_tb.log"
    RUN_RC=${PIPESTATUS[0]}
    LOG_PREFIX "  driver exit rc=$RUN_RC"
fi

# ============================================================================
# Stage 4: cleanup
# ============================================================================
if [[ "$STAGE_CLEANUP" == "1" ]]; then
    LOG_PREFIX "==== STAGE 4: cleanup ===="
    if [[ -n "$VLLM_PID" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
        kill -TERM "$VLLM_PID" 2>/dev/null || true
        for _ in {1..30}; do
            sleep 1
            kill -0 "$VLLM_PID" 2>/dev/null || break
        done
        kill -KILL "$VLLM_PID" 2>/dev/null || true
    fi
    # Stop any leftover TB instances from this job.
    singularity instance list 2>/dev/null | awk 'NR>1 && $1 ~ /^tb-/ {print $1}' | \
        xargs -r -n1 singularity instance stop 2>/dev/null || true
fi

LOG_PREFIX "==== done; rc=$RUN_RC ===="
exit $RUN_RC
