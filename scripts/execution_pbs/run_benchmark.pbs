#!/bin/bash
# bench profile (Qwen3.6-35B-A3B, tp=4) needs 4 GPUs. For the test profile
# (Qwen2.5-0.5B, tp=1) override at qsub time:
#   qsub -l select=1:ncpus=16:ngpus=4:mem=64gb -v VLLM_PROFILE=test pbs/run_benchmark.pbs
#PBS -l select=1:ncpus=1:ngpus=4:mem=64gb
#PBS -l walltime=24:00:00
#PBS -q normal
#PBS -j oe
#PBS -N oc_swebench_bench
# The script redirects stdout/stderr into
# data/experiments/$AB_RUN_STAMP/logs/pbs.log after resolving KIT_ROOT.
# Until then, PBS uses its job-id-based default output path.
#
# End-to-end benchmark on the cluster (no docker).
#
# Stages (each can be skipped via env flag):
#   0. STAGE_SWEBENCH=1  — pip install swebench into a persistent scratch
#                          lib cache ($OC_PYLIB), idempotent
#   1. STAGE_PULL=1      — pull SWE-bench instance .sif images via pull_images.sh
#   2. STAGE_VLLM=1      — start vLLM singularity, serve Qwen3.6
#   3. STAGE_OC_CHECK=1  — pull alpine/openclaw sif + bake patch overlay
#   3.5 STAGE_OTEL=1     — start local OTel collector that writes
#                          $OC_OTEL_DATA_DIR/otel-traces.jsonl, the file
#                          openclaw_agent.py slices into spans.jsonl
#   4. STAGE_RUN=1       — invoke orchestration/runner/driver with the sweep
#   5. STAGE_CLEANUP=1   — kill vLLM + OTel collector, free ports
#
# Env (override via `qsub -v K1=V1,K2=V2 ...`):
#   KIT_ROOT       — repo root (default: $PBS_O_WORKDIR or $HOME/Agent_Bench)
#   OC_PYLIB       — pip --target dir for swebench + deps (default: $SCRATCH/pylib)
#   OC_PIP_CACHE   — pip wheel cache (default: $SCRATCH/.pip-cache)
#   DATASET        — instance JSON (default: $KIT_ROOT/config/benchmarks/swebench/verified.json)
#   APP            — application JSON (default: $KIT_ROOT/config/application/swebench/phase1.json)
#                    Drives the instance list + scoring image + output_dir.
#   HARNESS_CONFIG — harness JSON  (default: $KIT_ROOT/config/harness/openclaw_27b.json)
#                    Selects model + agent runtime (openclaw / openhands / hermes).
#   BACKEND_CONFIG — backend JSON  (default: $KIT_ROOT/config/backend/vllm/tp1.json)
#                    vLLM/SGLang runtime knobs + serving_configs presets.
#   OC_PKG         — (deprecated, unused) host openclaw npm pkg location
#   SIF_DIR        — instance .sif dir (default: /scratch/users/ntu/$USER/swebench)
#   VLLM_SIF       — vllm sif path (default: /scratch/users/ntu/$USER/sif_images/vllm_openai.sif)
#   VLLM_MODEL     — model id (default: Qwen/Qwen3.6-35B-A3B)
#   VLLM_PORT      — vllm port (default: 8000)
#   VLLM_TP        — tensor parallel (default: 2 = ngpus)
#   AB_RUN_STAMP   — stable experiment directory name
#                    (default: Singapore wall time plus PBS_JOBID when present)
#   AB_EXPERIMENT_DIR — experiment root (default: $KIT_ROOT/data/experiments/$AB_RUN_STAMP)
#   OC_LOG_DIR     — log directory (default: $AB_EXPERIMENT_DIR/logs)
#   STAGE_*        — set to 0 to skip a stage
#
# Submit:
#   qsub pbs/run_benchmark.pbs
#   qsub -v STAGE_PULL=0,APP=$KIT_ROOT/config/application/swebench/phase0.json \
#        pbs/run_benchmark.pbs

set -uo pipefail   # not -e; we want stage failures to log + continue cleanup

# ---- Resolve paths ---------------------------------------------------------
USER_NAME="${USER:-$(whoami)}"
SCRATCH="/scratch/users/ntu/$USER_NAME"
HOME="/home/users/ntu/${USER_NAME}"
PBS_O_WORKDIR=${SCRATCH}/github/Agent_Bench
KIT_ROOT="${KIT_ROOT:-${PBS_O_WORKDIR:-$HOME/Agent_Bench}}"
# SWEBENCH_ROOT only needs to point at *some* directory — driver uses it
# for an existence check before delegating import work to PYTHONPATH.
# Stage 0 sets it to $OC_PYLIB; we pre-bind it here for the case where
# stage 0 is skipped.
SWEBENCH_ROOT="${SWEBENCH_ROOT:-$SCRATCH/pylib}"
DATASET="${DATASET:-$KIT_ROOT/config/benchmarks/swebench/verified.json}"
APP="${APP:-$KIT_ROOT/config/application/swebench/phase1.json}"
HARNESS_CONFIG="${HARNESS_CONFIG:-$KIT_ROOT/config/harness/openclaw_27b.json}"
BACKEND_CONFIG="${BACKEND_CONFIG:-$KIT_ROOT/config/backend/vllm/tp1.json}"

# OC_PKG is a vestige — nothing in this script (or the harness) consumes
# it. Stage 3 bakes patches into a singularity overlay against the alpine/
# openclaw sif's own /usr/local/lib/node_modules/openclaw, no host-side
# pkg dir needed. Stage 4 (driver) goes through the Container abstraction
# (orchestration/container/) which doesn't read OC_PKG either.
OC_PKG="${OC_PKG:-}"
SIF_DIR="${SIF_DIR:-$SCRATCH/swebench}"
SINGULARITY_CACHE="${SINGULARITY_CACHE:-$SCRATCH/.singularity}"

OC_RUNTIME_SIF="${OC_RUNTIME_SIF:-$SCRATCH/sif_images/oc_runtime.sif}"
OC_RUNTIME_DOCKER="${OC_RUNTIME_DOCKER:-docker://alpine/openclaw:main}"
OC_RUNTIME_OVERLAY="${OC_RUNTIME_OVERLAY:-$SCRATCH/sif_images/oc_runtime_patches.img}"
OC_INSIDE_PKG="${OC_INSIDE_PKG:-/usr/local/lib/node_modules/openclaw}"
OH_RUNTIME_SIF="${OH_RUNTIME_SIF:-$SCRATCH/sif_images/openhands_runtime.sif}"
OH_RUNTIME_DOCKER="${OH_RUNTIME_DOCKER:-docker://agent-bench/openhands:1.21.0}"
HM_RUNTIME_SIF="${HM_RUNTIME_SIF:-$SCRATCH/sif_images/hermes_runtime.sif}"
HM_RUNTIME_DOCKER="${HM_RUNTIME_DOCKER:-docker://agent-bench/hermes:v2026.5.16}"

# VLLM_PROFILE = test | bench
#   test  : small model (Qwen2.5-0.5B-Instruct), single GPU (or cpu). Smokes
#           the full pipeline (PBS / singularity / OC / scoring) cheaply.
#           CPU smoke run:
#             qsub -l select=1:ncpus=8:mem=32gb \
#                  -v VLLM_PROFILE=test,VLLM_DEVICE=cpu \
#                  pbs/run_benchmark.pbs
#   bench : production GPU run; the Qwen3.6-35B-A3B defaults below.
# Individual VLLM_* env vars still override profile-set defaults.
VLLM_PROFILE="${VLLM_PROFILE:-bench}"
case "$VLLM_PROFILE" in
    test)
        VLLM_DEVICE_DEFAULT=cuda
        VLLM_MODEL_DEFAULT="Qwen/Qwen2.5-0.5B-Instruct"
        VLLM_TP_DEFAULT=1
        VLLM_MAX_LEN_DEFAULT=8192
        ;;
    bench)
        VLLM_DEVICE_DEFAULT=cuda
        VLLM_MODEL_DEFAULT="Qwen/Qwen3.6-35B-A3B"
        VLLM_TP_DEFAULT=4
        # 2× A100-40GB: weights take ~33 GiB/GPU, leaving ~3 GiB headroom.
        # 131072 needs ~1.3 GiB per concurrent seq for KV — won't fit even one.
        # 32768 keeps ~8 full-length seqs in KV; covers the SWE-bench tail.
        VLLM_MAX_LEN_DEFAULT=262144
        ;;
    *)
        echo "FATAL: VLLM_PROFILE=$VLLM_PROFILE — must be 'test' or 'bench'" >&2
        exit 1
        ;;
esac

VLLM_DEVICE="${VLLM_DEVICE:-$VLLM_DEVICE_DEFAULT}"
VLLM_MODEL="${VLLM_MODEL:-$VLLM_MODEL_DEFAULT}"

# vllm sif path is device-dependent. The GPU image (vllm/vllm-openai) needs a
# CUDA driver matching its built-in CUDA toolkit; the CPU image
# (vllm/vllm-openai-cpu, also published by upstream) is independent. Override
# explicitly via VLLM_SIF if you have a custom build.
if [[ "$VLLM_DEVICE" == "cpu" ]]; then
    VLLM_SIF="${VLLM_SIF:-$SCRATCH/sif_images/vllm_openai_cpu.sif}"
    VLLM_DOCKER_DEFAULT="docker://vllm/vllm-openai-cpu:latest"
else
    VLLM_SIF="${VLLM_SIF:-$SCRATCH/sif_images/vllm_openai_cu128.sif}"
    VLLM_DOCKER_DEFAULT="docker://vllm/vllm-openai:latest"
fi
VLLM_DOCKER="${VLLM_DOCKER:-$VLLM_DOCKER_DEFAULT}"
VLLM_TP="${VLLM_TP:-$VLLM_TP_DEFAULT}"
VLLM_MAX_LEN="${VLLM_MAX_LEN:-$VLLM_MAX_LEN_DEFAULT}"
VLLM_PORT="${VLLM_PORT:-8000}"
# `--gpu-memory-utilization` is overloaded: on the CPU image it caps CPU RAM
# (default 0.92 trips OOM on small nodes since it includes other processes'
# allocations). Use a conservative default for cpu; bench profile keeps 0.90
# on GPU.
if [[ "$VLLM_DEVICE" == "cpu" ]]; then
    VLLM_GPU_UTIL="${VLLM_GPU_UTIL:-0.5}"
else
    # 0.93 just barely covers cudagraph capture overhead on 2× A100-40GB
    # (vllm warns at 0.9 that effective KV mem drops by 0.0228 due to graphs).
    VLLM_GPU_UTIL="${VLLM_GPU_UTIL:-0.93}"
fi

OC_PULL_PARALLEL="${OC_PULL_PARALLEL:-2}"

STAGE_SWEBENCH="${STAGE_SWEBENCH:-1}"
STAGE_PULL="${STAGE_PULL:-1}"
STAGE_VLLM="${STAGE_VLLM:-1}"
STAGE_OC_CHECK="${STAGE_OC_CHECK:-1}"
STAGE_OTEL="${STAGE_OTEL:-1}"
STAGE_RUN="${STAGE_RUN:-1}"
STAGE_CLEANUP="${STAGE_CLEANUP:-1}"

# Persistent pip cache. Single dir holds every package pulled in by stage 0 so
# subsequent jobs skip download. Located on scratch so it's cluster-shared
# and big.
OC_PYLIB="${OC_PYLIB:-$SCRATCH/pylib}"
OC_PIP_CACHE="${OC_PIP_CACHE:-$SCRATCH/.pip-cache}"

if [[ -z "${AB_RUN_STAMP:-}" ]]; then
    AB_RUN_STAMP="$(TZ=Asia/Singapore date +%Y-%m-%d_%H-%M-%S)"
    if [[ -n "${PBS_JOBID:-}" ]]; then
        AB_JOB_SUFFIX="${PBS_JOBID//[^A-Za-z0-9._-]/_}"
        AB_RUN_STAMP="${AB_RUN_STAMP}_${AB_JOB_SUFFIX}"
    fi
fi
export AB_RUN_STAMP

EXPERIMENT_DIR="${AB_EXPERIMENT_DIR:-$KIT_ROOT/data/experiments/$AB_RUN_STAMP}"
export AB_EXPERIMENT_DIR="$EXPERIMENT_DIR"

LOG_DIR="${OC_LOG_DIR:-$EXPERIMENT_DIR/logs}"
export OC_LOG_DIR="$LOG_DIR"

# OTel collector — local sidecar that catches OC gateway spans and writes
# them to $OC_OTEL_DATA_DIR/otel-traces.jsonl, which openclaw_agent.py
# slices into per-run spans.jsonl files. See pbs/otel_collector.sh for the
# full set of OC_OTEL_* env knobs.
OC_OTEL_DATA_DIR="${OC_OTEL_DATA_DIR:-$LOG_DIR/otel}"
export OC_OTEL_DATA_DIR
# Tell openclaw_agent.py where to read the trace file from. Default in code
# is /tmp/otel/otel-traces.jsonl which doesn't survive HPC tmpfs limits.
export OC_OTEL_TRACE_FILE="${OC_OTEL_TRACE_FILE:-$OC_OTEL_DATA_DIR/otel-traces.jsonl}"

mkdir -p "$EXPERIMENT_DIR/runs" "$LOG_DIR" "$SIF_DIR" "$SINGULARITY_CACHE" "$OC_OTEL_DATA_DIR"
cd "$KIT_ROOT"

LOG_PREFIX() { echo "[$(date -u +%FT%TZ)] $*"; }

# Keep a stable per-run copy of the whole job log. PBS's default job output is
# only a bootstrap fallback after this point.
exec >>"$LOG_DIR/pbs.log" 2>&1

LOG_PREFIX "kit_root      = $KIT_ROOT"
LOG_PREFIX "swebench_root = $SWEBENCH_ROOT"
LOG_PREFIX "run_stamp     = $AB_RUN_STAMP"
LOG_PREFIX "experiment    = $AB_EXPERIMENT_DIR"
LOG_PREFIX "log_dir       = $LOG_DIR"
LOG_PREFIX "app           = $APP"
LOG_PREFIX "harness       = $HARNESS_CONFIG"
LOG_PREFIX "backend       = $BACKEND_CONFIG"
LOG_PREFIX "dataset       = $DATASET"
LOG_PREFIX "oc_pkg        = $OC_PKG"
LOG_PREFIX "sif_dir       = $SIF_DIR"
LOG_PREFIX "vllm_sif      = $VLLM_SIF"
LOG_PREFIX "vllm profile  = $VLLM_PROFILE  device=$VLLM_DEVICE  model=$VLLM_MODEL  tp=$VLLM_TP  max_len=$VLLM_MAX_LEN"
LOG_PREFIX "stages: pull=$STAGE_PULL vllm=$STAGE_VLLM oc=$STAGE_OC_CHECK otel=$STAGE_OTEL run=$STAGE_RUN cleanup=$STAGE_CLEANUP"

# ---- Modules ---------------------------------------------------------------
module load singularity 2>/dev/null || LOG_PREFIX "WARN: 'module load singularity' failed; assuming binary on PATH"
command -v singularity >/dev/null 2>&1 || { LOG_PREFIX "FATAL: singularity not found"; exit 1; }
export SINGULARITY_CACHEDIR="$SINGULARITY_CACHE"

# Node + python from modules where available; else fall back to PATH.
# module load nodejs 2>/dev/null || true
module load python/3.12.1-gcc11 2>/dev/null || module load python 2>/dev/null || true
command -v python3 >/dev/null 2>&1 || { LOG_PREFIX "FATAL: python3 not found"; exit 1; }
# command -v node    >/dev/null 2>&1 || { LOG_PREFIX "FATAL: node not found"; exit 1; }

HARNESS_CHOICE="$(
python3 - "$HARNESS_CONFIG" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        print((json.load(fh).get("harness") or "openclaw").lower())
except Exception:
    print("openclaw")
PY
)"
LOG_PREFIX "harness_choice = $HARNESS_CHOICE"

# ============================================================================
# Stage 0: ensure SWE-bench checkout + python install
# ============================================================================
if [[ "$STAGE_SWEBENCH" == "1" ]]; then
    LOG_PREFIX "==== STAGE 0: pip install swebench into shared lib cache ===="
    mkdir -p "$OC_PYLIB" "$OC_PIP_CACHE"
    export PYTHONPATH="$OC_PYLIB:${PYTHONPATH:-}"
    LOG_PREFIX "  PYTHONPATH prefixed with $OC_PYLIB"
    LOG_PREFIX "  pip cache dir   = $OC_PIP_CACHE"

    if ! python3 -c "from swebench.harness.test_spec.test_spec import make_test_spec; from swebench.harness.grading import get_eval_report" 2>/dev/null; then
        LOG_PREFIX "  pip install --target $OC_PYLIB swebench (cached at $OC_PIP_CACHE)"
        python3 -m pip install \
            --target "$OC_PYLIB" \
            --cache-dir "$OC_PIP_CACHE" \
            --upgrade \
            swebench \
            >"$LOG_DIR/pip-swebench.log" 2>&1 \
            || { LOG_PREFIX "FATAL: pip install swebench failed; tail:"; tail -40 "$LOG_DIR/pip-swebench.log"; exit 1; }
        python3 -c "from swebench.harness.test_spec.test_spec import make_test_spec; from swebench.harness.grading import get_eval_report" \
            || { LOG_PREFIX "FATAL: swebench still not importable"; exit 1; }
        LOG_PREFIX "  swebench install OK"
    else
        LOG_PREFIX "  swebench already importable from $OC_PYLIB; skipping install"
    fi
    # Driver still passes a SWEBENCH_ROOT around for legacy reasons; point it
    # at the installed package dir so any directory-existence check succeeds.
    SWEBENCH_ROOT="$OC_PYLIB"

    # Materialize $DATASET as a slim JSON containing only the instances the
    # application config actually uses. Source of truth = the app JSON's
    # `instances:` list. Pulls full instance dicts (problem_statement /
    # test_patch / FAIL_TO_PASS / ...) from princeton-nlp/SWE-bench_Verified.
    LOG_PREFIX "  building $DATASET from $APP ids (HF SWE-bench_Verified)"
    mkdir -p "$(dirname "$DATASET")"
    OC_APP="$APP" OC_DATASET_OUT="$DATASET" \
    python3 - <<'PY' || { LOG_PREFIX "FATAL: dataset materialize failed"; exit 1; }
import json, os, sys
from datasets import load_dataset

app_path = os.environ["OC_APP"]
out_path = os.environ["OC_DATASET_OUT"]

with open(app_path) as fh:
    app = json.load(fh)
ids = list(app.get("instances") or [])
if not ids:
    print(f"app {app_path} has no instances", file=sys.stderr); sys.exit(1)

want = set(ids)
existing = []
if os.path.exists(out_path):
    try:
        existing = json.load(open(out_path))
        have = {d.get("instance_id") for d in existing}
        if want.issubset(have):
            print(f"  dataset already covers all {len(ids)} ids; skip"); sys.exit(0)
    except Exception:
        pass

hf_name  = os.environ.get("OC_HF_DATASET", "princeton-nlp/SWE-bench_Verified")
hf_split = os.environ.get("OC_HF_SPLIT", "test")
ds = load_dataset(hf_name, split=hf_split)
filt = [dict(r) for r in ds if r["instance_id"] in want]
missing = want - {d["instance_id"] for d in filt}
if missing:
    print(f"WARN: {len(missing)} ids not in HF dataset: {sorted(missing)[:5]}...", file=sys.stderr)

# Merge with any pre-existing file so multi-sweep prefetches accumulate.
keep_by_id = {d["instance_id"]: d for d in existing}
keep_by_id.update({d["instance_id"]: d for d in filt})
with open(out_path, "w") as fh:
    json.dump(list(keep_by_id.values()), fh)
print(f"  wrote {len(filt)} (total {len(keep_by_id)}) instances -> {out_path}")
PY
fi

# ============================================================================
# Stage 1: pull instance .sif images
# ============================================================================
if [[ "$STAGE_PULL" == "1" ]]; then
    LOG_PREFIX "==== STAGE 1: pull instance .sif images ===="
    if [[ ! -f "$DATASET" ]]; then
        LOG_PREFIX "ERROR: dataset not found at $DATASET — skipping pull"
    else
        # Only pull instances that this app config actually uses, not all 500.
        app_instances() {
            python3 - <<PY
import json, sys
with open("$APP") as fh:
    y = json.load(fh)
for i in y.get("instances") or []:
    print(i)
PY
        }
        TMP_LIST="$SIF_DIR/.app_instances.txt"
        app_instances > "$TMP_LIST"
        LOG_PREFIX "  pulling $(wc -l < "$TMP_LIST") instances from $APP"
        OC_SIF_DIR="$SIF_DIR" bash "$KIT_ROOT/scripts/execution_pbs/pull_images.sh" \
            --instances "$TMP_LIST" \
            --dir "$SIF_DIR" \
            --parallel "$OC_PULL_PARALLEL" \
            || LOG_PREFIX "WARN: some pulls failed (see $SIF_DIR/*.pull.log)"
    fi
fi

# ============================================================================
# Stage 2: vLLM singularity
# ============================================================================
VLLM_LOG="$LOG_DIR/vllm.log"
VLLM_PID=""
if [[ "$STAGE_VLLM" == "1" ]]; then
    LOG_PREFIX "==== STAGE 2: start vLLM singularity (profile=$VLLM_PROFILE, device=$VLLM_DEVICE) ===="
    LOG_PREFIX "  vllm sif    = $VLLM_SIF"
    LOG_PREFIX "  vllm docker = $VLLM_DOCKER"
    if [[ ! -f "$VLLM_SIF" ]]; then
        LOG_PREFIX "  vllm sif not found; pulling $VLLM_DOCKER"
        mkdir -p "$(dirname "$VLLM_SIF")"
        if ! singularity pull "$VLLM_SIF" "$VLLM_DOCKER" >>"$LOG_DIR/vllm-pull.log" 2>&1; then
            LOG_PREFIX "FATAL: singularity pull failed; tail of $LOG_DIR/vllm-pull.log:"
            tail -30 "$LOG_DIR/vllm-pull.log"
            exit 2
        fi
        LOG_PREFIX "  pulled vllm sif → $VLLM_SIF"
    fi
    : > "$VLLM_LOG"
    # Redirect every "throwaway" cache + tmp dir from /tmp (small tmpfs on HPC
    # compute nodes) to scratch. Pre-create every subdir vllm/torch/HF will
    # touch — `--containall` later strips host binds, so any path that isn't
    # explicitly bound (or pre-created under a bound parent) blows up at
    # runtime ("Read-only file system" / FileNotFoundError).
    OC_TMPDIR="${OC_TMPDIR:-$SCRATCH/.tmp/$PBS_JOBID}"
    mkdir -p \
        "$OC_TMPDIR" \
        "$SCRATCH/.cache/huggingface" \
        "$SCRATCH/.cache/torchinductor" \
        "$SCRATCH/.cache/triton" \
        "$SCRATCH/.cache/vllm" \
        "$SCRATCH/.cache/vllm/modelinfos"
    # Don't `export TMPDIR` on the host — singularity (without --containall)
    # leaks the host TMPDIR into the OC gateway container in stage 4, where
    # $SCRATCH/.tmp/$PBS_JOBID isn't bound and node's os.tmpdir() crashes
    # with ENOENT. SINGULARITYENV_TMPDIR is enough to point vllm at scratch
    # while leaving the host-side TMPDIR at its default (/tmp) for stage 4.
    export SINGULARITYENV_TMPDIR="$OC_TMPDIR"
    export SINGULARITYENV_TORCHINDUCTOR_CACHE_DIR="$SCRATCH/.cache/torchinductor"
    export SINGULARITYENV_HF_HOME="$SCRATCH/.cache/huggingface"
    export SINGULARITYENV_HUGGINGFACE_HUB_CACHE="$SCRATCH/.cache/huggingface"
    export SINGULARITYENV_XDG_CACHE_HOME="$SCRATCH/.cache"
    export SINGULARITYENV_VLLM_CACHE_ROOT="$SCRATCH/.cache/vllm"
    # Triton's cache manager ignores XDG_CACHE_HOME — it uses $TRITON_CACHE_DIR,
    # falling back to $HOME/.triton/cache. With --containall, $HOME points at
    # the container's tiny overlay (no scratch bind), so kernel compiles bomb
    # with `OSError: [Errno 28] No space left on device` partway through MoE
    # autotune. Force the cache + base dir onto bound scratch.
    export SINGULARITYENV_TRITON_CACHE_DIR="$SCRATCH/.cache/triton"
    export SINGULARITYENV_TRITON_HOME="$SCRATCH/.cache/triton"
    LOG_PREFIX "  TMPDIR              = $OC_TMPDIR"
    LOG_PREFIX "  XDG_CACHE_HOME      = $SCRATCH/.cache"

    # CPU profile sanity check: vllm reserves 1 core internally; ncpus=1
    # leaves 0 for workers and trips libgomp `OMP_NUM_THREADS="0"`. Need ≥2.
    if [[ "$VLLM_DEVICE" == "cpu" ]]; then
        AVAILABLE_CPUS="$(nproc 2>/dev/null || echo 1)"
        if (( AVAILABLE_CPUS < 2 )); then
            LOG_PREFIX "FATAL: CPU profile needs at least 2 CPUs (saw $AVAILABLE_CPUS)."
            LOG_PREFIX "  Resubmit with: -l select=1:ncpus=8:mem=32gb (or more)"
            exit 2
        fi
        LOG_PREFIX "  cpu count    = $AVAILABLE_CPUS"
    fi

    # CUDA driver visibility: singularity's --nv only works if libcuda.so.1
    # and friends are visible on the host. On HPC nodes that means loading
    # the cluster's cuda module before launching the container. Default to
    # cuda/12.2.2 (matches vllm-openai image's CUDA 12.x build); override
    # with OC_CUDA_MODULE=cuda/<version> if your cluster names it differently.
    # NB: the cluster's `cuda` (no version) default is 11.6.2 which is too
    # old for recent vllm.
    if [[ "$VLLM_DEVICE" == "cuda" ]]; then
        OC_CUDA_MODULE="${OC_CUDA_MODULE:-cuda/12.2.2}"
        if module load "$OC_CUDA_MODULE" 2>/dev/null; then
            LOG_PREFIX "  module load $OC_CUDA_MODULE  ok"
        else
            LOG_PREFIX "  WARN: module load $OC_CUDA_MODULE failed; relying on host cuda"
        fi
        if ! command -v nvidia-smi >/dev/null 2>&1 \
                || ! nvidia-smi -L >/dev/null 2>&1; then
            LOG_PREFIX "FATAL: no GPU visible on this node."
            LOG_PREFIX "  - Is the PBS job requesting a GPU? (e.g. -l select=1:ncpus=8:ngpus=1)"
            LOG_PREFIX "  - Is the cuda module loaded? (set OC_CUDA_MODULE=<your-module>)"
            LOG_PREFIX "  - Override with VLLM_DEVICE=cpu to force CPU."
            exit 2
        fi
        LOG_PREFIX "  nvidia-smi   = $(nvidia-smi -L | head -1)"
    fi

    # Build the vllm-serve flag list per profile.
    # Recent vllm dropped `--device` entirely — GPU images auto-detect cuda,
    # CPU images (vllm-openai-cpu) are CPU-only builds. Device choice now
    # drives sif selection + singularity --nv only.
    # `--gpu-memory-utilization` is accepted by both images (overloaded to
    # mean CPU-RAM utilization on the CPU build).
    VLLM_SERVE_FLAGS=(
        --host 0.0.0.0 --port "$VLLM_PORT"
        --tensor-parallel-size "$VLLM_TP"
        --max-model-len "$VLLM_MAX_LEN"
        --trust-remote-code
        --enable-prefix-caching
        --gpu-memory-utilization "$VLLM_GPU_UTIL"
    )
    if [[ "$VLLM_PROFILE" == "bench" ]]; then
        VLLM_SERVE_FLAGS+=(
            --reasoning-parser qwen3
            --enable-auto-tool-choice
            --tool-call-parser qwen3_coder
            --max-num-seqs 128
        )
    else
        # test profile: small Qwen2.5 — no reasoning, hermes-style tool calls.
        VLLM_SERVE_FLAGS+=(
            --enable-auto-tool-choice
            --tool-call-parser hermes
            --max-num-seqs 16
        )
    fi

    SING_GPU_FLAG=()
    [[ "$VLLM_DEVICE" == "cuda" ]] && SING_GPU_FLAG=(--nv)

    LOG_PREFIX "  vllm device  = $VLLM_DEVICE"
    LOG_PREFIX "  vllm model   = $VLLM_MODEL"
    LOG_PREFIX "  vllm flags   = ${VLLM_SERVE_FLAGS[*]}"
    LOG_PREFIX "  --nv passed  = $([[ ${#SING_GPU_FLAG[@]} -gt 0 ]] && echo yes || echo no)"

    # --containall: full isolation (= --contain --cleanenv --no-home).
    # Without this, singularity bind-mounts $HOME by default; the host's
    # ~/.local/lib/python3.12/site-packages is then auto-added to sys.path
    # by the container's python and shadows the container's own packages
    # (transformers' version check failed because host's huggingface-hub
    # 1.12 was picked up over the container's bundled <1.0).
    # Bind the scratch cache root and the per-job tmpdir as the same paths
    # they have on the host so SINGULARITYENV_{TMPDIR,XDG_CACHE_HOME,HF_HOME,
    # TORCHINDUCTOR_CACHE_DIR,VLLM_CACHE_ROOT} resolve to real, writable dirs.
    singularity exec "${SING_GPU_FLAG[@]}" --containall \
        --bind "$SCRATCH/.cache:$SCRATCH/.cache:rw" \
        --bind "$OC_TMPDIR:$OC_TMPDIR:rw" \
        --bind "$KIT_ROOT/logs:/logs" \
        "$VLLM_SIF" \
        vllm serve "$VLLM_MODEL" "${VLLM_SERVE_FLAGS[@]}" \
        > "$VLLM_LOG" 2>&1 &
    VLLM_PID=$!
    LOG_PREFIX "  vllm pid=$VLLM_PID, log=$VLLM_LOG"

    # Now that vllm has forked (it inherited these via the export), strip the
    # vllm-specific SINGULARITYENV_* vars from the parent shell so they don't
    # leak into stage 4's `singularity exec` for the OC gateway. The OC sif
    # only binds state_dir / workspace_base / plugin-cache, so a SINGULARITYENV_
    # TMPDIR pointing at $SCRATCH/.tmp/<jobid> makes node's os.tmpdir() resolve
    # to a path that doesn't exist inside the container — gateway then crashes
    # with `ENOENT, mkdir '/scratch/users/ntu/<user>/.tmp'`.
    unset SINGULARITYENV_TMPDIR \
          SINGULARITYENV_TORCHINDUCTOR_CACHE_DIR \
          SINGULARITYENV_HF_HOME \
          SINGULARITYENV_HUGGINGFACE_HUB_CACHE \
          SINGULARITYENV_XDG_CACHE_HOME \
          SINGULARITYENV_VLLM_CACHE_ROOT

    # Poll for ready
    DEADLINE=$(( $(date +%s) + 1800 ))
    until curl -fsS "http://127.0.0.1:$VLLM_PORT/v1/models" >/dev/null 2>&1; do
        if ! kill -0 "$VLLM_PID" 2>/dev/null; then
            LOG_PREFIX "FATAL: vllm exited; tail of log:"
            tail -50 "$VLLM_LOG"
            exit 3
        fi
        if [ "$(date +%s)" -ge "$DEADLINE" ]; then
            LOG_PREFIX "FATAL: vllm not ready after 1800s"
            tail -50 "$VLLM_LOG"
            kill "$VLLM_PID" 2>/dev/null || true
            exit 3
        fi
        sleep 10
    done
    LOG_PREFIX "  vllm ready on http://127.0.0.1:$VLLM_PORT"

    # Sidecar: poll vLLM's Prometheus /metrics endpoint at iteration cadence
    # (default 100ms) and emit JSONL with running/waiting sequence counts,
    # token throughput, and KV cache utilization. /metrics gauges update on
    # every scheduler step, so polling here gives true iteration-level
    # resolution — vLLM's stdout-log stats are rate-limited to 5-10s and
    # lose iteration granularity. Output joins with util_sampler.jsonl +
    # spans.jsonl on ts_ns during offline analysis.
    OC_ENGINE="${OC_ENGINE:-vllm}"
    ENGINE_METRICS_LOG="${OC_ENGINE_METRICS_LOG:-$LOG_DIR/engine_metrics.jsonl}"
    ENGINE_TAILER_LOG="$LOG_DIR/engine_log_tailer.log"
    OC_ENGINE_INTERVAL="${OC_ENGINE_INTERVAL:-0.1}"
    python3 "$KIT_ROOT/backend/engine_log_tailer.py" \
        --engine "$OC_ENGINE" \
        --source metrics \
        --base-url "http://127.0.0.1:$VLLM_PORT" \
        --interval "$OC_ENGINE_INTERVAL" \
        --output "$ENGINE_METRICS_LOG" \
        > "$ENGINE_TAILER_LOG" 2>&1 &
    ENGINE_TAILER_PID=$!
    LOG_PREFIX "  engine metrics tailer pid=$ENGINE_TAILER_PID -> $ENGINE_METRICS_LOG (interval=${OC_ENGINE_INTERVAL}s)"
fi

# ============================================================================
# Stage 3: pull agent runtime sif + OpenClaw overlay/cache when needed
# ============================================================================
ensure_runtime_sif() {
    local label="$1" sif="$2" docker_ref="$3"
    mkdir -p "$(dirname "$sif")"
    if [[ ! -f "$sif" ]]; then
        LOG_PREFIX "  pulling $label runtime: $docker_ref -> $sif"
        singularity pull --dir "$(dirname "$sif")" \
            --name "$(basename "$sif")" "$docker_ref"
    else
        LOG_PREFIX "  $label runtime sif already present at $sif"
    fi
}

export OC_SCORING_SIF_DIR="$SIF_DIR"

if [[ "$STAGE_OC_CHECK" == "1" ]]; then
    LOG_PREFIX "==== STAGE 3: ensure $HARNESS_CHOICE runtime sif ===="
    case "$HARNESS_CHOICE" in
        openclaw)
            ensure_runtime_sif "openclaw" "$OC_RUNTIME_SIF" "$OC_RUNTIME_DOCKER"
            LOG_PREFIX "  building OC patch overlay at $OC_RUNTIME_OVERLAY"
            bash "$KIT_ROOT/scripts/execution_pbs/build_oc_overlay.sh" \
                --sif "$OC_RUNTIME_SIF" \
                --overlay "$OC_RUNTIME_OVERLAY" \
                --kit-root "$KIT_ROOT" \
                --inside-pkg "$OC_INSIDE_PKG" \
                || { LOG_PREFIX "FATAL: build_oc_overlay.sh failed"; exit 4; }
            export OC_OC_SIF="$OC_RUNTIME_SIF"
            export OC_OC_OVERLAY="$OC_RUNTIME_OVERLAY"
            ;;
        openhands)
            ensure_runtime_sif "openhands" "$OH_RUNTIME_SIF" "$OH_RUNTIME_DOCKER"
            export OH_RUNTIME_SIF
            export OH_IMAGE="$OH_RUNTIME_SIF"
            ;;
        hermes)
            ensure_runtime_sif "hermes" "$HM_RUNTIME_SIF" "$HM_RUNTIME_DOCKER"
            export HM_RUNTIME_SIF
            export HM_IMAGE="$HM_RUNTIME_SIF"
            ;;
        *)
            LOG_PREFIX "FATAL: unsupported harness_choice=$HARNESS_CHOICE"
            exit 4
            ;;
    esac
fi

if [[ "$HARNESS_CHOICE" == "openclaw" ]]; then
    # Wire Singularity OpenClaw: runtime sif + read-only patch overlay.
    export OC_OC_SIF="${OC_OC_SIF:-$OC_RUNTIME_SIF}"
    export OC_OC_OVERLAY="${OC_OC_OVERLAY:-$OC_RUNTIME_OVERLAY}"
    : "${OC_PLUGIN_CACHE:=$SCRATCH/oc-eval/plugin-cache}"
    export OC_PLUGIN_CACHE
    mkdir -p "$OC_PLUGIN_CACHE"

    # Direct egress to registry.npmjs.org is blocked from this cluster; route
    # the in-sif npm at the Taobao mirror. Override via OC_NPM_MIRROR if needed.
    NPM_MIRROR_URL="${OC_NPM_MIRROR:-https://registry.npmmirror.com}"
    LOG_PREFIX "  using npm registry mirror: $NPM_MIRROR_URL"
    export SINGULARITYENV_NPM_CONFIG_REGISTRY="$NPM_MIRROR_URL"
    export SINGULARITYENV_NODE_OPTIONS="--dns-result-order=ipv4first"

    OC_STATE_TEMPLATE_TMP="$(mktemp -d -t oc-state-XXXXXX)"
    trap 'rm -rf "$OC_STATE_TEMPLATE_TMP"' EXIT
    cp "$KIT_ROOT/harnesses/openclaw/state/openclaw.json" "$OC_STATE_TEMPLATE_TMP/openclaw.json"
    mkdir -p "$OC_STATE_TEMPLATE_TMP/agents/swebench"
    cp "$KIT_ROOT/applications/swebench/openclaw/agents/"*.md "$OC_STATE_TEMPLATE_TMP/agents/swebench/"

    if ! find "$OC_PLUGIN_CACHE" -mindepth 2 -name package.json -print -quit | grep -q .; then
        LOG_PREFIX "  plugin cache cold at $OC_PLUGIN_CACHE; warming..."
        if bash "$KIT_ROOT/scripts/execution_pbs/warm_oc_plugins.sh" \
                --sif "$OC_OC_SIF" \
                --overlay "$OC_OC_OVERLAY" \
                --cache "$OC_PLUGIN_CACHE" \
                --state-template "$OC_STATE_TEMPLATE_TMP"; then
            LOG_PREFIX "  plugin cache warmed"
        else
            LOG_PREFIX "FATAL: plugin cache warm failed."
            LOG_PREFIX "  Run on a node with internet access:"
            LOG_PREFIX "    bash $KIT_ROOT/scripts/execution_pbs/warm_oc_plugins.sh \\"
            LOG_PREFIX "        --sif $OC_OC_SIF --overlay $OC_OC_OVERLAY \\"
            LOG_PREFIX "        --cache $OC_PLUGIN_CACHE \\"
            LOG_PREFIX "        --state-template <merged: harnesses/openclaw/state + applications/swebench/openclaw/agents>"
            exit 5
        fi
    else
        LOG_PREFIX "  plugin cache already warm at $OC_PLUGIN_CACHE"
    fi

    bash "$KIT_ROOT/scripts/execution_pbs/oc_plugin_cache_clean.sh" \
        "$OC_PLUGIN_CACHE" "$KIT_ROOT/harnesses/openclaw/state/openclaw.json" \
        2>&1 | sed "s|^|$(date +%H:%M:%S) [run_benchmark] |" || true
fi

# ============================================================================
# Stage 3.5: start local OTel collector (optional but the only way spans.jsonl
# files get produced — the OC gateway emits OTLP/HTTP to 127.0.0.1:$OC_OTEL_PORT
# and openclaw_agent.py slices the resulting trace file into per-run jsonl).
# Best-effort: a failure here only loses telemetry, not the run itself.
# ============================================================================
if [[ "$STAGE_OTEL" == "1" ]]; then
    LOG_PREFIX "==== STAGE 3.5: start OTel collector ===="
    if bash "$KIT_ROOT/scripts/execution_pbs/otel_collector.sh" start; then
        LOG_PREFIX "  OTel collector ready at 127.0.0.1:${OC_OTEL_PORT:-4318}"
        LOG_PREFIX "  trace file -> $OC_OTEL_TRACE_FILE"
    else
        LOG_PREFIX "  WARN: OTel collector failed to start; spans.jsonl will be missing"
        LOG_PREFIX "        (run continues — OC agent works without telemetry)"
    fi
fi

# ============================================================================
# Stage 4: run benchmark
# ============================================================================
RUN_RC=0
if [[ "$STAGE_RUN" == "1" ]]; then
    LOG_PREFIX "==== STAGE 4: run benchmark ===="
    export KIT_ROOT
    export HARNESS_BACKEND=singularity
    export OC_HOST_WORKSPACE_BASE="$SCRATCH/oc-eval/workspaces"
    mkdir -p "$OC_HOST_WORKSPACE_BASE"

    # Per-component CPU split: hand vLLM's pid to the sampler so cpu.by_group
    # in util.jsonl attributes engine work to "llm_engine". Driver/gateway
    # pids are picked up by the sampler from the live process tree.
    [[ -n "$VLLM_PID" ]] && export OC_LLM_PID="$VLLM_PID"

    python3 -m orchestration.runner.driver \
        --app "$APP" \
        --harness "$HARNESS_CONFIG" \
        --backend "$BACKEND_CONFIG" \
        --swebench-root "$SWEBENCH_ROOT" \
        --instance-data "$DATASET" \
        2>&1 | tee -a "$LOG_DIR/run.log"
    RUN_RC=${PIPESTATUS[0]}
    LOG_PREFIX "  driver exit rc=$RUN_RC"
fi

# ============================================================================
# Stage 5: cleanup
# ============================================================================
if [[ "$STAGE_CLEANUP" == "1" ]]; then
    LOG_PREFIX "==== STAGE 5: cleanup ===="
    # Stop OTel first so the file exporter flushes its remaining batches
    # while the agent's last spans are still being written. Order matters —
    # SIGTERM on otelcol triggers a graceful flush; SIGKILL would lose the
    # tail of the trace file.
    if [[ "$STAGE_OTEL" == "1" ]]; then
        bash "$KIT_ROOT/scripts/execution_pbs/otel_collector.sh" stop || true
    fi
    # Stop the engine log tailer before vLLM so it captures the final scheduler
    # tick that fires as vLLM tears down. SIGTERM triggers a clean JSONL flush.
    if [[ -n "${ENGINE_TAILER_PID:-}" ]] && kill -0 "$ENGINE_TAILER_PID" 2>/dev/null; then
        LOG_PREFIX "  stopping engine log tailer pid=$ENGINE_TAILER_PID"
        kill -TERM "$ENGINE_TAILER_PID" 2>/dev/null || true
        for _ in {1..10}; do
            sleep 0.5
            kill -0 "$ENGINE_TAILER_PID" 2>/dev/null || break
        done
        kill -KILL "$ENGINE_TAILER_PID" 2>/dev/null || true
    fi
    if [[ -n "$VLLM_PID" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
        LOG_PREFIX "  stopping vllm pid=$VLLM_PID"
        kill -TERM "$VLLM_PID" 2>/dev/null || true
        for _ in {1..30}; do
            sleep 1
            kill -0 "$VLLM_PID" 2>/dev/null || break
        done
        kill -KILL "$VLLM_PID" 2>/dev/null || true
    fi
fi

LOG_PREFIX "==== done; rc=$RUN_RC ===="
exit $RUN_RC
