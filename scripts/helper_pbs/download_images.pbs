#!/bin/bash
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -N download_model 
#PBS -o /scratch/users/ntu/chengzh2/logs/download_model.log

USER=chengzh2
MODEL=Qwen/Qwen2.5-0.5B-Instruct
scratch=/scratch/users/ntu/$USER

module load singularity
module load cuda
singularity exec \
  -B $scratch/models:/home/users/ntu/chengzh2/.cache/huggingface\
  /scratch/users/ntu/$USER/sif_images/vllm_openai.sif \
  hf download Qwen/Qwen2.5-0.5B-Instruct >> $scratch/logs/download_qwen.log 
