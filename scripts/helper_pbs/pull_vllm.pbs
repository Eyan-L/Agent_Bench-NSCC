#!/bin/bash
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -N download_vllm_sif
#PBS -o ./logs/download_vllm_sif.log

scratch_dir="/scratch/users/ntu/$USER"

mkdir -p $scratch_dir/.singularity/cache $scratch_dir/sif_images

# check if image exists
if [ -f "$scratch_dir/sif_images/vllm_openai_cu128.sif" ]; then
    echo "vllm_openai_cu128.sif already exists, skipping pull."
    exit 0
fi

module load singularity
export SINGULARITY_CACHEDIR=$scratch_dir/.singularity
singularity pull $scratch_dir/sif_images/vllm_openai_cu128.sif docker://chengzhilu/vllm:0.20.0-torch2.11-cu128-a100-h100
echo "vllm_openai_cu128.sif image pulled."
